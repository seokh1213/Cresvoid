{
  "timeout_sec": 10,
  "tests": [
    {
      "name": "morning-orders",
      "refs": [
        "3",
        "5",
        "8"
      ],
      "quote": "페이지 번호는 RUN마다 1부터 시작한다.",
      "input": [
        "ADD a 0",
        "RUN 1 1",
        "SHOW a",
        "QUEUE"
      ],
      "expected": [
        "ADDED a",
        "PAGE 1 a:OK",
        "END pages=1 attempts=1 completed=1 pending=0",
        "ORDER a DONE attempts=1 failures=0",
        "QUEUE -"
      ]
    },
    {
      "name": "afternoon-orders",
      "refs": [
        "5",
        "6",
        "8"
      ],
      "quote": "남은 주문이 적으면 남은 주문만 고른다.",
      "input": [
        "QUEUE",
        "RUN 2 4",
        "ADD a 0",
        "ADD b 0",
        "ADD c 0",
        "ADD d 0",
        "ADD e 0",
        "RUN 2 2",
        "QUEUE",
        "SHOW e",
        "RUN 4 3",
        "SHOW e"
      ],
      "expected": [
        "QUEUE -",
        "END pages=0 attempts=0 completed=0 pending=0",
        "ADDED a",
        "ADDED b",
        "ADDED c",
        "ADDED d",
        "ADDED e",
        "PAGE 1 a:OK,b:OK",
        "PAGE 2 c:OK,d:OK",
        "END pages=2 attempts=4 completed=4 pending=1",
        "QUEUE e",
        "ORDER e WAITING attempts=0 failures=0",
        "PAGE 1 e:OK",
        "END pages=1 attempts=1 completed=1 pending=0",
        "ORDER e DONE attempts=1 failures=0"
      ]
    },
