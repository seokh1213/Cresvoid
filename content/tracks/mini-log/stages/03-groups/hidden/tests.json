        "4.22"
      ],
      "quote": "POLL 은 받은 레코드를 받은 순서대로 한 줄에 하나씩 `<토픽> <파티션> <오프셋> <키> <값>` 으로 출력한다.",
      "input": [
        "CREATE orders 2",
        "PRODUCE orders k1 a",
        "PRODUCE orders k2 b",
        "PRODUCE orders k3 c",
        "GROUP billing range orders auto.offset.reset=earliest",
        "JOIN billing c1",
        "ASSIGNMENT billing",
        "POLL c1 10",
        "COMMIT c1",
        "COMMITTED billing"
      ],
      "expected": [
        "partition=1 offset=0",
        "partition=0 offset=0",
        "partition=1 offset=1",
        "generation=1",
        "c1 alive orders-0,orders-1",
        "orders 0 0 k2 b",
        "orders 1 0 k1 a",
        "orders 1 1 k3 c",
        "orders 0 committed=1 end=1",
        "orders 1 committed=2 end=2"
      ]
    },
