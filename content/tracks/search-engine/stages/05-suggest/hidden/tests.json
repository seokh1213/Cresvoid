{
  "timeout_sec": 10,
  "tests": [
    {
      "name": "suggest-basic",
      "refs": [
        "1.1",
        "4.1",
        "4.6",
        "4.11"
      ],
      "quote": "후보 하나는 `<토큰>:<문서 빈도>` 꼴로 쓴다.",
      "input": [
        "ADD 1 search engine",
        "ADD 2 searching sea",
        "ADD 3 search season",
        "SUGGEST 10 sea",
        "SUGGEST 10 eng",
        "SUGGEST 1 sea"
      ],
      "expected": [
        "search:2 sea:1 searching:1 season:1",
        "engine:1",
        "search:2"
      ]
    },
    {
      "name": "prefix-match",
      "refs": [
        "4.7",
        "4.12",
        "4.6"
      ],
      "quote": "접두 토큰과 같은 토큰도 후보다.",
      "input": [
        "ADD 1 data database metadata dat",
        "ADD 2 dataset",
        "SUGGEST 10 data",
        "SUGGEST 10 dat",
        "SUGGEST 10 datab",
        "SUGGEST 10 databases",
        "SUGGEST 10 meta",
        "SUGGEST 10 tada",
        "SUGGEST 10 d"
      ],
      "expected": [
        "data:1 database:1 dataset:1",
        "dat:1 data:1 database:1 dataset:1",
        "database:1",
        "(none)",
        "metadata:1",
        "(none)",
        "dat:1 data:1 database:1 dataset:1"
      ]
    },
    {
