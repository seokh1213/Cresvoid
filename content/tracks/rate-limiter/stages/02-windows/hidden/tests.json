      ],
      "quote": "창 제한기로 보낸 REQ 는 `fixed=<판정>:<고정 창 개수> log=<판정>:<기록 개수> sliding=<판정>:<근사 개수>` 한 줄을 출력한다.",
      "input": [
        "WINDOW w 2 1000",
        "REQ w a 100",
        "REQ w a 200",
        "REQ w a 300",
        "REPORT w"
      ],
      "expected": [
        "fixed=ALLOW:1 log=ALLOW:1 sliding=ALLOW:1",
        "fixed=ALLOW:2 log=ALLOW:2 sliding=ALLOW:2",
        "fixed=DENY:3 log=DENY:3 sliding=DENY:3",
        "log requests=3 allowed=2",
        "fixed allowed=2 wrong_allow=0 wrong_deny=0 max_error=0",
        "sliding allowed=2 wrong_allow=0 wrong_deny=0 max_error=0",
        "stored log=3 fixed=1 sliding=1"
      ]
    },
