        "\\.",
        "COPY events FROM STDIN",
        "u1\t1\t100",
        "u2\t2\t200\textra",
        "\\.",
        "COPY events FROM STDIN",
        "u1\t1\t100",
        "u2\ty\t200",
        "u3\t3",
        "\\.",
        "COPY events FROM STDIN",
        "",
        "\\.",
        "COPY events FROM STDIN",
        "u1\t1\t100",
        "u1\t1\t100",
        "u1\t1\t100",
        "u4\t4\t400\t",
        "\\.",
        "SELECT COUNT(*) FROM events",
        "COPY events FROM STDIN",
        "u1\t1\t100",
        "u2\t2\t200",
        "\\.",
        "SELECT COUNT(*), SUM(ms) FROM events"
      ],
      "expected": [
        "ERR VALUE_COUNT 2",
        "ERR VALUE_COUNT 2",
        "ERR TYPE 2",
        "ERR VALUE_COUNT 1",
        "ERR VALUE_COUNT 4",
        "COUNT(*)",
        "0",
        "COUNT(*)|SUM(ms)",
        "2|300"
