    {
      "name": "count-distinct-basics",
      "refs": [
        "4.8",
        "2.8",
        "4.9"
      ],
      "quote": "그룹에서 NULL 이 아닌 그 열 값 가운데 서로 다른 값의 수다.",
      "input": [
        "CREATE TABLE plays (user STRING, song STRING, secs INT)",
        "COPY plays FROM STDIN",
        "u1\ts1\t30",
        "u1\ts1\t30",
        "u1\ts2\t\\N",
        "u2\ts1\t45",
        "u2\t\\N\t45",
        "u3\t\t10",
        "u3\t\\N\t\\N",
        "\\N\ts3\t10",
        "\\.",
        "SELECT COUNT(DISTINCT user), COUNT(DISTINCT song), COUNT(DISTINCT secs), COUNT(*) FROM plays",
        "SELECT user, COUNT(DISTINCT song), COUNT(song), COUNT(DISTINCT secs) FROM plays GROUP BY user",
        "SELECT COUNT(DISTINCT song), COUNT(*) FROM plays WHERE secs > 100",
        "SELECT song, COUNT(DISTINCT user) FROM plays GROUP BY song",
        "INSERT INTO plays VALUES ('u3', '', 10), ('u4', 's1', 30)",
        "SELECT COUNT(DISTINCT song), COUNT(DISTINCT user), COUNT(DISTINCT secs) FROM plays WHERE user >= 'u3'"
      ],
      "expected": [
        "COUNT(DISTINCT user)|COUNT(DISTINCT song)|COUNT(DISTINCT secs)|COUNT(*)",
        "3|4|3|8",
        "user|COUNT(DISTINCT song)|COUNT(song)|COUNT(DISTINCT secs)",
        "'u1'|2|3|1",
        "'u2'|1|1|1",
        "'u3'|1|1|1",
        "NULL|1|1|1",
        "COUNT(DISTINCT song)|COUNT(*)",
        "0|0",
        "song|COUNT(DISTINCT user)",
        "''|1",
        "'s1'|2",
        "'s2'|1",
        "'s3'|0",
        "NULL|2",
        "COUNT(DISTINCT song)|COUNT(DISTINCT user)|COUNT(DISTINCT secs)",
        "2|2|2"
      ]
    },
    {
      "name": "count-distinct-items",
      "refs": [
        "4.9",
        "4.8"
      ],
      "quote": "`COUNT(DISTINCT ms)` 와 `COUNT(ms)` 는 다른 항목이다.",
      "input": [
        "CREATE TABLE plays (user STRING, song STRING, secs INT)",
        "COPY plays FROM STDIN",
        "u1\ts1\t30",
        "u1\ts1\t30",
        "u1\ts2\t\\N",
        "u2\ts1\t45",
        "u2\t\\N\t45",
        "u3\t\t10",
        "u3\t\\N\t\\N",
        "\\N\ts3\t10",
        "\\.",
        "SELECT user, COUNT(DISTINCT song) FROM plays GROUP BY user ORDER BY COUNT(DISTINCT song) DESC, user DESC",
        "SELECT user, COUNT ( DISTINCT   song ) FROM plays GROUP BY user ORDER BY COUNT(DISTINCT song) LIMIT 2",
        "SELECT user, COUNT(DISTINCT secs) FROM plays GROUP BY user ORDER BY COUNT(secs)",
        "SELECT user, COUNT(secs) FROM plays GROUP BY user ORDER BY COUNT(DISTINCT secs)",
        "SELECT user FROM plays GROUP BY user ORDER BY COUNT(DISTINCT song)",
        "SELECT COUNT(DISTINCT album) FROM plays",
        "SELECT user, COUNT(DISTINCT zz) FROM plays GROUP BY user ORDER BY COUNT(DISTINCT song)",
        "SELECT COUNT(distinct) FROM plays",
        "SELECT COUNT(DISTINCT *) FROM plays",
        "SELECT COUNT(DISTINCT) FROM plays",
        "SELECT SUM(DISTINCT secs) FROM plays",
        "SELECT COUNT(DISTINCT user, song) FROM plays",
        "SELECT COUNT(DISTINCT user), COUNT(DISTINCT user), COUNT(user) FROM plays",
        "SELECT secs, COUNT(DISTINCT user) FROM plays GROUP BY secs ORDER BY COUNT(DISTINCT user) DESC NULLS LAST, secs DESC"
      ],
      "expected": [
        "user|COUNT(DISTINCT song)",
        "'u1'|2",
        "NULL|1",
        "'u3'|1",
        "'u2'|1",
        "user|COUNT(DISTINCT song)",
        "'u2'|1",
        "'u3'|1",
        "ERR NOT_SELECTED",
        "ERR NOT_SELECTED",
        "ERR NOT_SELECTED",
        "ERR NO_COLUMN album",
        "ERR NO_COLUMN zz",
        "ERR NO_COLUMN distinct",
        "ERR SYNTAX",
        "ERR SYNTAX",
        "ERR SYNTAX",
        "ERR SYNTAX",
        "COUNT(DISTINCT user)|COUNT(DISTINCT user)|COUNT(user)",
        "3|3|7",
        "secs|COUNT(DISTINCT user)",
        "NULL|2",
        "45|1",
        "30|1",
        "10|1"
      ]
    },
    {
      "name": "copy-and-insert-together",
      "refs": [
        "5.1",
        "4.6"
      ],
      "quote": "INSERT 의 오류 줄은 1단계대로 번호 없는 `ERR VALUE_COUNT` 와 `ERR TYPE` 이다.",
      "input": [
        "CREATE TABLE sales (region STRING, qty INT)",
        "INSERT INTO sales VALUES ('east', 1), ('west', 2)",
        "COPY sales FROM STDIN",
        "east\t3",
        "\\N\t4",
        "\\.",
        "INSERT INTO sales VALUES ('north', 'x')",
        "INSERT INTO sales VALUES ('north')",
        "COPY sales FROM STDIN",
        "north\t5",
        "south\tx",
        "\\.",
        "INSERT INTO sales VALUES ('south', 6)",
        "COPY sales FROM STDIN",
        "west\t7",
        "\\.",
        "SELECT region, COUNT(*), SUM(qty), AVG(qty) FROM sales GROUP BY region",
        "SELECT COUNT(*), COUNT(DISTINCT region), MIN(qty), MAX(qty) FROM sales"
      ],
      "expected": [
        "ERR TYPE",
        "ERR VALUE_COUNT",
        "ERR TYPE 2",
        "region|COUNT(*)|SUM(qty)|AVG(qty)",
        "'east'|2|4|2.00",
        "'south'|1|6|6.00",
        "'west'|2|9|4.50",
        "NULL|1|4|4.00",
        "COUNT(*)|COUNT(DISTINCT region)|MIN(qty)|MAX(qty)",
        "6|3|1|7"
      ]
    },
    {
      "name": "string-order-after-copy",
      "refs": [
        "2.6",
        "4.4",
        "4.6"
      ],
      "quote": "같은지 따지는 비교와 그룹 나누기에는 번호만으로 충분하지만 `<` 와 `>` 같은 비교, MIN, MAX, 정렬에는 값의 순서가 필요하다.",
      "input": [
        "CREATE TABLE cities (name STRING, pop INT)",
        "COPY cities FROM STDIN",
        "zeta\t5",
        "alpha\t3",
        "Beta\t9",
        " gamma\t1",
        "가평\t4",
        "alp\t8",
        "delta\t\\N",
        "\t2",
        "alpha\t6",
        "\\N\t7",
        "Zulu\t10",
        "\\.",
        "SELECT name, SUM(pop) FROM cities GROUP BY name",
        "SELECT MIN(name), MAX(name) FROM cities",
        "SELECT name FROM cities WHERE name < 'alpha' GROUP BY name",
        "SELECT name FROM cities WHERE name >= 'b' GROUP BY name ORDER BY name DESC",
        "SELECT name, MAX(pop) FROM cities WHERE name > 'Z' AND name <= 'alpha' GROUP BY name ORDER BY MAX(pop) DESC",
        "SELECT COUNT(*), COUNT(DISTINCT name) FROM cities WHERE name <> 'alpha'"
      ],
      "expected": [
        "name|SUM(pop)",
        "''|2",
        "' gamma'|1",
        "'Beta'|9",
        "'Zulu'|10",
        "'alp'|8",
        "'alpha'|9",
        "'delta'|NULL",
        "'zeta'|5",
        "'가평'|4",
        "NULL|7",
        "MIN(name)|MAX(name)",
        "''|'가평'",
        "name",
        "''",
        "' gamma'",
        "'Beta'",
        "'Zulu'",
        "'alp'",
        "name",
        "'가평'",
        "'zeta'",
        "'delta'",
        "name|MAX(pop)",
        "'Zulu'|10",
        "'alp'|8",
        "'alpha'|6",
        "COUNT(*)|COUNT(DISTINCT name)",
        "8|8"
      ]
    },
