{
  "timeout_sec": 10,
  "tests": [
    {
      "name": "copy-basics",
      "refs": [
        "4.1",
        "1.1",
        "1.2",
        "4.2",
        "4.3",
        "4.6"
      ],
      "quote": "`COPY <테이블> FROM STDIN` 은 다음 줄부터 오는 데이터 줄을 그 테이블에 행으로 넣는다.",
      "input": [
        "CREATE TABLE visits (user STRING, page STRING, ms INT)",
        "COPY visits FROM STDIN",
        "u1\t/home\t120",
        "u2\t/cart\t45",
        "u1\t/cart\t80",
        "\\.",
        "SELECT user, COUNT(*), SUM(ms) FROM visits GROUP BY user",
        "SELECT page, MIN(ms), MAX(ms) FROM visits GROUP BY page"
      ],
      "expected": [
        "user|COUNT(*)|SUM(ms)",
        "'u1'|2|200",
        "'u2'|1|45",
        "page|MIN(ms)|MAX(ms)",
        "'/cart'|45|80",
        "'/home'|120|120"
      ]
    },
    {
      "name": "copy-cell-values",
      "refs": [
        "4.4",
        "2.4",
        "2.9",
        "3.2",
        "4.3"
      ],
      "quote": "칸의 앞뒤 공백도 값의 일부다.",
      "input": [
        "CREATE TABLE notes (who STRING, text STRING, n INT)",
        "COPY notes FROM STDIN",
        "a\t\t1",
        "b\t\\N\t\\N",
        "c\tNULL\t2",
        " d \t x\t3",
        "가\t한글 메모\t-4",
        "e\ta|b\t1000000000",
        "\\N\t~!@#$%^&*()\t-1000000000",
        "f\t   \t0",
        "\\.",
        "SELECT who, text, n FROM notes GROUP BY who, text, n",
        "SELECT COUNT(*), COUNT(who), COUNT(text), COUNT(n), SUM(n) FROM notes",
        "SELECT COUNT(*) FROM notes WHERE text = ''",
        "SELECT COUNT(*) FROM notes WHERE text IS NULL",
        "SELECT COUNT(*) FROM notes WHERE text = 'NULL'",
        "SELECT COUNT(*) FROM notes WHERE who = 'd' OR who = ' d'",
        "SELECT MIN(text), MAX(text), MIN(who), MAX(who) FROM notes"
      ],
      "expected": [
        "who|text|n",
        "' d '|' x'|3",
        "'a'|''|1",
        "'b'|NULL|NULL",
        "'c'|'NULL'|2",
        "'e'|'a|b'|1000000000",
        "'f'|'   '|0",
        "'가'|'한글 메모'|-4",
        "NULL|'~!@#$%^&*()'|-1000000000",
        "COUNT(*)|COUNT(who)|COUNT(text)|COUNT(n)|SUM(n)",
        "8|7|7|7|2",
        "COUNT(*)",
        "1",
        "COUNT(*)",
        "1",
        "COUNT(*)",
        "1",
        "COUNT(*)",
        "0",
        "MIN(text)|MAX(text)|MIN(who)|MAX(who)",
        "''|'한글 메모'|' d '|'가'"
      ]
    },
    {
      "name": "copy-data-lines",
      "refs": [
        "4.2",
        "3.1",
        "4.3",
        "4.4",
        "4.6",
        "4.7"
      ],
      "quote": "앞뒤에 공백이 붙은 `\\.` 은 끝 줄이 아니라 데이터 줄이다.",
      "input": [
        "CREATE TABLE lines (body STRING)",
        "COPY lines FROM STDIN",
        "",
        "   ",
        "SELECT COUNT(*) FROM lines",
        "COPY lines FROM STDIN",
        "INSERT INTO lines VALUES (1)",
        "\\.",
        "SELECT body, COUNT(*) FROM lines GROUP BY body",
        "COPY lines FROM STDIN",
        "alpha",
        " \\.",
        "\\. ",
        "beta",
        "\\.",
        "SELECT COUNT(*) FROM lines",
        "COPY lines FROM STDIN",
        "\\.",
        "SELECT COUNT(*) FROM lines",
        "CREATE TABLE pairs (a STRING, b STRING)",
        "COPY pairs FROM STDIN",
        "x\t",
        "\t",
        "\ty",
        "\\N\t",
        "\\.",
        "SELECT a, b, COUNT(*) FROM pairs GROUP BY a, b"
      ],
      "expected": [
        "body|COUNT(*)",
        "''|1",
        "'   '|1",
        "'COPY lines FROM STDIN'|1",
        "'INSERT INTO lines VALUES (1)'|1",
        "'SELECT COUNT(*) FROM lines'|1",
        "ERR TYPE 2",
        "COUNT(*)",
        "5",
        "COUNT(*)",
        "5",
        "a|b|COUNT(*)",
        "''|''|1",
        "''|'y'|1",
        "'x'|''|1",
        "NULL|''|1"
      ]
    },
