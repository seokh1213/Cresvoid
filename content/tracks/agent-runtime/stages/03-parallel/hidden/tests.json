{
  "timeout_sec": 10,
  "tests": [
    {
      "name": "parallel-basic",
      "refs": [
        "1.1",
        "4.9",
        "4.15",
        "4.18",
        "4.19",
        "4.20"
      ],
      "quote": "결과는 끝난 순서와 상관없이 도구 사용 블록의 순서대로 한 사용자 메시지에 담는다.",
      "input": [
        "config {\"trace\":true}",
        "tool {\"name\":\"fetch\"}",
        "fake {\"tool\":\"fetch\",\"input\":{\"url\":\"a\"},\"output\":\"A\",\"ms\":300}",
        "fake {\"tool\":\"fetch\",\"input\":{\"url\":\"b\"},\"output\":\"B\",\"ms\":100}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"a1\",\"name\":\"fetch\",\"input\":{\"url\":\"a\"}},{\"type\":\"tool\",\"id\":\"b1\",\"name\":\"fetch\",\"input\":{\"url\":\"b\"}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"두 페이지를 읽었다.\"}]}",
        "ask {\"text\":\"두 페이지를 읽어 줘\"}"
      ],
      "expected": [
        "user text \"두 페이지를 읽어 줘\"",
        "turn 1 messages=1 limit=1000",
        "model tool a1 fetch {\"url\":\"a\"}",
        "model tool b1 fetch {\"url\":\"b\"}",
        "stop tool",
        "exec b1 0 100 ok 1",
        "exec a1 0 300 ok 1",
        "clock 300",
        "user result a1 ok \"A\"",
        "user result b1 ok \"B\"",
        "turn 2 messages=3 limit=1000",
        "model text \"두 페이지를 읽었다.\"",
        "stop end",
        "done end \"두 페이지를 읽었다.\""
      ]
    },
    {
      "name": "slot-assignment",
      "refs": [
        "4.9",
        "4.10",
        "4.5",
        "4.7",
        "4.19"
      ],
      "quote": "빈 슬롯과 준비된 블록이 함께 있으면 실행기는 준비된 블록 가운데 블록 순서가 가장 앞선 블록의 다음 시도를 그 시각에 시작한다.",
      "input": [
        "config {\"trace\":true}",
        "tool {\"name\":\"job\"}",
        "fake {\"tool\":\"job\",\"input\":{\"n\":1},\"output\":\"1\",\"ms\":500}",
        "fake {\"tool\":\"job\",\"input\":{\"n\":2},\"output\":\"2\",\"ms\":200}",
        "fake {\"tool\":\"job\",\"input\":{\"n\":3},\"output\":\"3\",\"ms\":300}",
        "fake {\"tool\":\"job\",\"input\":{\"n\":4},\"output\":\"4\",\"ms\":100}",
        "fake {\"tool\":\"job\",\"input\":{\"n\":5},\"output\":\"5\",\"ms\":50}",
        "fake {\"tool\":\"job\",\"input\":{\"n\":6},\"output\":\"6\",\"ms\":400}",
        "fake {\"tool\":\"job\",\"input\":{\"n\":7},\"output\":\"7\",\"ms\":100}",
        "fake {\"tool\":\"job\",\"input\":{\"n\":8},\"output\":\"8\",\"ms\":250}",
        "fake {\"tool\":\"job\",\"input\":{\"n\":9},\"output\":\"9\"}",
        "fake {\"tool\":\"job\",\"input\":{\"n\":10},\"output\":\"10\",\"ms\":30}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"j1\",\"name\":\"job\",\"input\":{\"n\":1}},{\"type\":\"tool\",\"id\":\"j2\",\"name\":\"job\",\"input\":{\"n\":2}},{\"type\":\"tool\",\"id\":\"j3\",\"name\":\"job\",\"input\":{\"n\":3}},{\"type\":\"tool\",\"id\":\"j4\",\"name\":\"job\",\"input\":{\"n\":4}},{\"type\":\"tool\",\"id\":\"j5\",\"name\":\"job\",\"input\":{\"n\":5}},{\"type\":\"tool\",\"id\":\"j6\",\"name\":\"job\",\"input\":{\"n\":6}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"여섯 작업을 마쳤다.\"}]}",
        "ask {\"text\":\"작업 여섯 개를 돌려 줘\"}",
        "config {\"concurrency\":2}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"k1\",\"name\":\"job\",\"input\":{\"n\":7}},{\"type\":\"tool\",\"id\":\"k2\",\"name\":\"ghost\",\"input\":{\"n\":7}},{\"type\":\"tool\",\"id\":\"k3\",\"name\":\"job\",\"input\":{\"n\":4}},{\"type\":\"tool\",\"id\":\"k4\",\"name\":\"job\",\"input\":{\"n\":99}},{\"type\":\"tool\",\"id\":\"k5\",\"name\":\"job\",\"input\":{\"n\":7}},{\"type\":\"tool\",\"id\":\"k6\",\"name\":\"job\",\"input\":{\"n\":8}},{\"type\":\"tool\",\"id\":\"k7\",\"name\":\"job\",\"input\":{\"n\":5}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"두 줄로 돌렸다.\"}]}",
        "ask {\"text\":\"두 개씩 돌려 줘\"}",
        "config {\"concurrency\":1}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"h1\",\"name\":\"job\",\"input\":{\"n\":9}},{\"type\":\"tool\",\"id\":\"h2\",\"name\":\"job\",\"input\":{\"n\":10}},{\"type\":\"tool\",\"id\":\"h3\",\"name\":\"job\",\"input\":{\"n\":9}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"하나씩 돌렸다.\"}]}",
        "ask {\"text\":\"하나씩 돌려 줘\"}"
      ],
      "expected": [
        "user text \"작업 여섯 개를 돌려 줘\"",
        "turn 1 messages=1 limit=1000",
        "model tool j1 job {\"n\":1}",
        "model tool j2 job {\"n\":2}",
        "model tool j3 job {\"n\":3}",
        "model tool j4 job {\"n\":4}",
        "model tool j5 job {\"n\":5}",
        "model tool j6 job {\"n\":6}",
        "stop tool",
        "exec j4 0 100 ok 1",
        "exec j5 100 150 ok 1",
        "exec j2 0 200 ok 1",
        "exec j3 0 300 ok 1",
        "exec j1 0 500 ok 1",
        "exec j6 150 550 ok 1",
        "clock 550",
        "user result j1 ok \"1\"",
        "user result j2 ok \"2\"",
        "user result j3 ok \"3\"",
        "user result j4 ok \"4\"",
        "user result j5 ok \"5\"",
        "user result j6 ok \"6\"",
        "turn 2 messages=3 limit=1000",
        "model text \"여섯 작업을 마쳤다.\"",
        "stop end",
        "done end \"여섯 작업을 마쳤다.\"",
        "user text \"두 개씩 돌려 줘\"",
        "turn 1 messages=5 limit=1000",
        "model tool k1 job {\"n\":7}",
        "model tool k2 ghost {\"n\":7}",
        "model tool k3 job {\"n\":4}",
        "model tool k4 job {\"n\":99}",
        "model tool k5 job {\"n\":7}",
        "model tool k6 job {\"n\":8}",
        "model tool k7 job {\"n\":5}",
        "stop tool",
        "exec k1 0 100 ok 1",
        "exec k3 0 100 ok 1",
        "exec k5 100 200 ok 1",
        "exec k7 200 250 ok 1",
        "exec k6 100 350 ok 1",
        "clock 350",
        "user result k1 ok \"7\"",
        "user result k2 error \"unknown tool: ghost\"",
        "user result k3 ok \"4\"",
        "user result k4 error \"no result for this input\"",
        "user result k5 ok \"7\"",
        "user result k6 ok \"8\"",
        "user result k7 ok \"5\"",
        "turn 2 messages=7 limit=1000",
        "model text \"두 줄로 돌렸다.\"",
        "stop end",
        "done end \"두 줄로 돌렸다.\"",
        "user text \"하나씩 돌려 줘\"",
        "turn 1 messages=9 limit=1000",
        "model tool h1 job {\"n\":9}",
        "model tool h2 job {\"n\":10}",
        "model tool h3 job {\"n\":9}",
        "stop tool",
        "exec h1 0 0 ok 1",
        "exec h2 0 30 ok 1",
        "exec h3 30 30 ok 1",
        "clock 30",
        "user result h1 ok \"9\"",
        "user result h2 ok \"10\"",
        "user result h3 ok \"9\"",
        "turn 2 messages=11 limit=1000",
        "model text \"하나씩 돌렸다.\"",
        "stop end",
        "done end \"하나씩 돌렸다.\""
      ]
    },
