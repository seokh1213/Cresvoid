    {
      "name": "timeout-rules",
      "refs": [
        "4.11",
        "4.13",
        "4.5",
        "4.6"
      ],
      "quote": "d 가 timeout_ms 와 같으면 시간 초과가 아니다.",
      "input": [
        "config {\"trace\":true,\"timeout_ms\":250}",
        "tool {\"name\":\"quote\"}",
        "fake {\"tool\":\"quote\",\"input\":{\"sku\":\"A\"},\"output\":\"A가\",\"ms\":250}",
        "fake {\"tool\":\"quote\",\"input\":{\"sku\":\"B\"},\"output\":\"B가\",\"ms\":251}",
        "fake {\"tool\":\"quote\",\"input\":{\"sku\":\"C\"},\"error\":\"품절\",\"ms\":400}",
        "fake {\"tool\":\"quote\",\"input\":{\"sku\":\"D\"},\"error\":\"없음\",\"ms\":100}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"qa\",\"name\":\"quote\",\"input\":{\"sku\":\"A\"}},{\"type\":\"tool\",\"id\":\"qb\",\"name\":\"quote\",\"input\":{\"sku\":\"B\"}},{\"type\":\"tool\",\"id\":\"qc\",\"name\":\"quote\",\"input\":{\"sku\":\"C\"}},{\"type\":\"tool\",\"id\":\"qd\",\"name\":\"quote\",\"input\":{\"sku\":\"D\"}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"둘은 늦었다.\"}]}",
        "ask {\"text\":\"네 상품 가격을 알려 줘\"}",
        "config {\"timeout_ms\":0}",
        "fake {\"tool\":\"quote\",\"input\":{\"sku\":\"B\"},\"output\":\"B가\",\"ms\":1000000000}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"qe\",\"name\":\"quote\",\"input\":{\"sku\":\"B\"}},{\"type\":\"tool\",\"id\":\"qf\",\"name\":\"quote\",\"input\":{\"sku\":\"C\"}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"기다려서 받았다.\"}]}",
        "ask {\"text\":\"끝까지 기다려 줘\"}"
      ],
      "expected": [
        "user text \"네 상품 가격을 알려 줘\"",
        "turn 1 messages=1 limit=1000",
        "model tool qa quote {\"sku\":\"A\"}",
        "model tool qb quote {\"sku\":\"B\"}",
        "model tool qc quote {\"sku\":\"C\"}",
        "model tool qd quote {\"sku\":\"D\"}",
        "stop tool",
        "exec qd 0 100 error 1",
        "exec qa 0 250 ok 1",
        "exec qb 0 250 timeout 1",
        "exec qc 0 250 timeout 1",
        "clock 250",
        "user result qa ok \"A가\"",
        "user result qb error \"timeout after 250 ms\"",
        "user result qc error \"timeout after 250 ms\"",
        "user result qd error \"없음\"",
        "turn 2 messages=3 limit=1000",
        "model text \"둘은 늦었다.\"",
        "stop end",
        "done end \"둘은 늦었다.\"",
        "user text \"끝까지 기다려 줘\"",
        "turn 1 messages=5 limit=1000",
        "model tool qe quote {\"sku\":\"B\"}",
        "model tool qf quote {\"sku\":\"C\"}",
        "stop tool",
        "exec qf 0 400 error 1",
        "exec qe 0 1000000000 ok 1",
        "clock 1000000000",
        "user result qe ok \"B가\"",
        "user result qf error \"품절\"",
        "turn 2 messages=7 limit=1000",
        "model text \"기다려서 받았다.\"",
        "stop end",
        "done end \"기다려서 받았다.\""
      ]
    },
    {
      "name": "retries-and-attempts",
      "refs": [
        "4.4",
        "4.10",
        "4.12",
        "4.13",
        "4.18"
      ],
      "quote": "시도가 실패했을 때 도구에 부수효과가 없고 지금까지 한 시도의 수가 retries 이하이면 블록은 다시 시도한다.",
      "input": [
        "config {\"trace\":true,\"retries\":2,\"timeout_ms\":100}",
        "tool {\"name\":\"read\"}",
        "fake {\"tool\":\"read\",\"input\":{\"f\":1},\"attempts\":[{\"error\":\"busy\",\"ms\":10},{\"error\":\"busy again\",\"ms\":20},{\"output\":\"third\",\"ms\":30}]}",
        "fake {\"tool\":\"read\",\"input\":{\"f\":2},\"attempts\":[{\"error\":\"e1\",\"ms\":5}]}",
        "fake {\"tool\":\"read\",\"input\":{\"f\":3},\"attempts\":[{\"output\":\"first\",\"ms\":40},{\"output\":\"second\"}]}",
        "fake {\"tool\":\"read\",\"input\":{\"f\":4},\"attempts\":[{\"output\":\"slow\",\"ms\":500},{\"error\":\"fail fast\",\"ms\":1}]}",
        "fake {\"tool\":\"read\",\"input\":{\"f\":5},\"error\":\"down\"}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"r1\",\"name\":\"read\",\"input\":{\"f\":1}},{\"type\":\"tool\",\"id\":\"r2\",\"name\":\"read\",\"input\":{\"f\":2}},{\"type\":\"tool\",\"id\":\"r3\",\"name\":\"read\",\"input\":{\"f\":3}},{\"type\":\"tool\",\"id\":\"r4\",\"name\":\"read\",\"input\":{\"f\":4}},{\"type\":\"tool\",\"id\":\"r5\",\"name\":\"read\",\"input\":{\"f\":5}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"다시 시도까지 마쳤다.\"}]}",
        "ask {\"text\":\"다섯 파일을 읽어 줘\"}",
        "config {\"retries\":0}",
        "fake {\"tool\":\"read\",\"input\":{\"f\":6},\"attempts\":[{\"error\":\"once\",\"ms\":7},{\"output\":\"never\"}]}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"r6\",\"name\":\"read\",\"input\":{\"f\":6}},{\"type\":\"tool\",\"id\":\"r7\",\"name\":\"read\",\"input\":{\"f\":1}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"한 번씩만 시도했다.\"}]}",
        "ask {\"text\":\"한 번씩만 읽어 줘\"}"
      ],
      "expected": [
        "user text \"다섯 파일을 읽어 줘\"",
        "turn 1 messages=1 limit=1000",
        "model tool r1 read {\"f\":1}",
        "model tool r2 read {\"f\":2}",
        "model tool r3 read {\"f\":3}",
        "model tool r4 read {\"f\":4}",
        "model tool r5 read {\"f\":5}",
        "stop tool",
        "exec r2 0 15 error 3",
        "exec r5 15 15 error 3",
        "exec r3 0 40 ok 1",
        "exec r1 0 60 ok 3",
        "exec r4 0 102 error 3",
        "clock 102",
        "user result r1 ok \"third\"",
        "user result r2 error \"e1\"",
        "user result r3 ok \"first\"",
        "user result r4 error \"fail fast\"",
        "user result r5 error \"down\"",
        "turn 2 messages=3 limit=1000",
        "model text \"다시 시도까지 마쳤다.\"",
        "stop end",
        "done end \"다시 시도까지 마쳤다.\"",
        "user text \"한 번씩만 읽어 줘\"",
        "turn 1 messages=5 limit=1000",
        "model tool r6 read {\"f\":6}",
        "model tool r7 read {\"f\":1}",
        "stop tool",
        "exec r6 0 7 error 1",
        "exec r7 0 10 error 1",
        "clock 10",
        "user result r6 error \"once\"",
        "user result r7 error \"busy\"",
        "turn 2 messages=7 limit=1000",
        "model text \"한 번씩만 시도했다.\"",
        "stop end",
        "done end \"한 번씩만 시도했다.\""
      ]
    },
    {
      "name": "side-effect-no-retry",
      "refs": [
        "4.1",
        "4.12",
        "4.13",
        "2.6"
      ],
      "quote": "시간 초과로 실패했으면 오류 결과이고 내용은 부수효과가 없는 도구이면 `timeout after <timeout_ms> ms`, 부수효과가 있는 도구이면 `timeout after <timeout_ms> ms; outcome unknown` 이다.",
      "input": [
        "config {\"trace\":true,\"retries\":3,\"timeout_ms\":200}",
        "tool {\"name\":\"pay\",\"side_effect\":true}",
        "tool {\"name\":\"mail\",\"side_effect\":false}",
        "fake {\"tool\":\"pay\",\"input\":{\"order\":1},\"error\":\"card declined\",\"ms\":50}",
        "fake {\"tool\":\"pay\",\"input\":{\"order\":2},\"output\":\"paid\",\"ms\":300}",
        "fake {\"tool\":\"pay\",\"input\":{\"order\":3},\"attempts\":[{\"error\":\"busy\",\"ms\":10},{\"output\":\"paid 3\",\"ms\":10}]}",
        "fake {\"tool\":\"mail\",\"input\":{\"to\":\"a\"},\"attempts\":[{\"output\":\"slow\",\"ms\":300},{\"output\":\"sent\",\"ms\":100}]}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"p1\",\"name\":\"pay\",\"input\":{\"order\":1}},{\"type\":\"tool\",\"id\":\"p2\",\"name\":\"pay\",\"input\":{\"order\":2}},{\"type\":\"tool\",\"id\":\"p3\",\"name\":\"pay\",\"input\":{\"order\":3}},{\"type\":\"tool\",\"id\":\"m1\",\"name\":\"mail\",\"input\":{\"to\":\"a\"}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"결제 결과를 확인해야 한다.\"}]}",
        "ask {\"text\":\"세 건을 결제하고 메일을 보내 줘\"}",
        "tool {\"name\":\"pay\"}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"p4\",\"name\":\"pay\",\"input\":{\"order\":2}},{\"type\":\"tool\",\"id\":\"p5\",\"name\":\"pay\",\"input\":{\"order\":3}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"다시 결제했다.\"}]}",
        "ask {\"text\":\"다시 결제해 줘\"}"
      ],
      "expected": [
        "user text \"세 건을 결제하고 메일을 보내 줘\"",
        "turn 1 messages=1 limit=1000",
        "model tool p1 pay {\"order\":1}",
        "model tool p2 pay {\"order\":2}",
        "model tool p3 pay {\"order\":3}",
        "model tool m1 mail {\"to\":\"a\"}",
        "stop tool",
        "exec p3 0 10 error 1",
        "exec p1 0 50 error 1",
        "exec p2 0 200 timeout 1",
        "exec m1 0 300 ok 2",
        "clock 300",
        "user result p1 error \"card declined\"",
        "user result p2 error \"timeout after 200 ms; outcome unknown\"",
        "user result p3 error \"busy\"",
        "user result m1 ok \"sent\"",
        "turn 2 messages=3 limit=1000",
        "model text \"결제 결과를 확인해야 한다.\"",
        "stop end",
        "done end \"결제 결과를 확인해야 한다.\"",
        "user text \"다시 결제해 줘\"",
        "turn 1 messages=5 limit=1000",
        "model tool p4 pay {\"order\":2}",
        "model tool p5 pay {\"order\":3}",
