{
  "timeout_sec": 10,
  "tests": [
    {
      "name": "permission-basic",
      "refs": [
        "1.1",
        "4.10",
        "4.11",
        "4.12",
        "4.19",
        "4.23"
      ],
      "quote": "읽기 도구는 허락 없이 실행한다.",
      "input": [
        "config {\"allow\":[\"write_file\",\"delete_file\"]}",
        "tool {\"name\":\"read_file\"}",
        "tool {\"name\":\"write_file\",\"level\":\"write\"}",
        "tool {\"name\":\"delete_file\",\"level\":\"irreversible\"}",
        "fake {\"tool\":\"read_file\",\"input\":{\"path\":\"a.txt\"},\"output\":\"안녕\"}",
        "fake {\"tool\":\"write_file\",\"input\":{\"path\":\"b.txt\",\"text\":\"메모\"},\"output\":\"b.txt 를 썼다\"}",
        "fake {\"tool\":\"delete_file\",\"input\":{\"path\":\"c.txt\"},\"output\":\"c.txt 를 지웠다\"}",
        "confirm {\"tool\":\"delete_file\",\"input\":{\"path\":\"c.txt\"}}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"t1\",\"name\":\"read_file\",\"input\":{\"path\":\"a.txt\"}},{\"type\":\"tool\",\"id\":\"t2\",\"name\":\"write_file\",\"input\":{\"path\":\"b.txt\",\"text\":\"메모\"}},{\"type\":\"tool\",\"id\":\"t3\",\"name\":\"delete_file\",\"input\":{\"path\":\"c.txt\"}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"세 작업을 마쳤다.\"}]}",
        "ask {\"text\":\"a.txt 를 읽고 b.txt 에 쓰고 c.txt 를 지워 줘\"}",
        "audit {}"
      ],
      "expected": [
        "user text \"a.txt 를 읽고 b.txt 에 쓰고 c.txt 를 지워 줘\"",
        "turn 1 messages=1 limit=1000",
        "model tool t1 read_file {\"path\":\"a.txt\"}",
        "model tool t2 write_file {\"path\":\"b.txt\",\"text\":\"메모\"}",
        "model tool t3 delete_file {\"path\":\"c.txt\"}",
        "stop tool",
        "user result t1 ok \"안녕\"",
        "user result t2 ok \"b.txt 를 썼다\"",
        "user result t3 ok \"c.txt 를 지웠다\"",
        "turn 2 messages=3 limit=1000",
        "model text \"세 작업을 마쳤다.\"",
        "stop end",
        "done end \"세 작업을 마쳤다.\"",
        "audit 4",
        "log 1 confirm delete_file {\"path\":\"c.txt\"}",
        "log 2 run t1 read_file {\"path\":\"a.txt\"}",
        "log 3 run t2 write_file {\"path\":\"b.txt\",\"text\":\"메모\"}",
        "log 4 run t3 delete_file {\"path\":\"c.txt\"}"
      ]
    },
    {
      "name": "write-permission",
      "refs": [
        "4.11",
        "4.5",
        "4.2",
        "4.13",
        "4.6"
      ],
      "quote": "쓰기 도구의 블록은 도구가 허락받은 도구이면 통과한다.",
      "input": [
        "config {\"allow\":[\"save\",\"read_db\",\"ghost\",\"save\"]}",
        "tool {\"name\":\"read_db\"}",
        "tool {\"name\":\"save\",\"level\":\"write\"}",
        "tool {\"name\":\"publish\",\"level\":\"write\"}",
        "fake {\"tool\":\"read_db\",\"input\":{\"q\":\"orders\"},\"output\":\"3건\"}",
        "fake {\"tool\":\"save\",\"input\":{\"doc\":\"draft\"},\"output\":\"초안을 저장했다\"}",
        "fake {\"tool\":\"publish\",\"input\":{\"doc\":\"draft\"},\"output\":\"초안을 게시했다\"}",
        "confirm {\"tool\":\"publish\",\"input\":{\"doc\":\"draft\"}}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"q1\",\"name\":\"read_db\",\"input\":{\"q\":\"orders\"}},{\"type\":\"tool\",\"id\":\"s1\",\"name\":\"save\",\"input\":{\"doc\":\"draft\"}},{\"type\":\"tool\",\"id\":\"p1\",\"name\":\"publish\",\"input\":{\"doc\":\"draft\"}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"저장은 했고 게시는 막혔다.\"}]}",
        "ask {\"text\":\"주문을 세고 초안을 저장한 뒤 게시해 줘\"}",
        "config {\"allow\":[\"publish\"]}",
        "config {\"allow\":[\"publish\",3]}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"s2\",\"name\":\"save\",\"input\":{\"doc\":\"draft\"}},{\"type\":\"tool\",\"id\":\"p2\",\"name\":\"publish\",\"input\":{\"doc\":\"draft\"}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"게시는 했고 저장은 막혔다.\"}]}",
        "ask {\"text\":\"다시 저장하고 게시해 줘\"}",
        "tool {\"name\":\"save\"}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"s3\",\"name\":\"save\",\"input\":{\"doc\":\"draft\"}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"저장했다.\"}]}",
        "ask {\"text\":\"저장만 해 줘\"}",
        "audit {}"
      ],
      "expected": [
        "user text \"주문을 세고 초안을 저장한 뒤 게시해 줘\"",
        "turn 1 messages=1 limit=1000",
        "model tool q1 read_db {\"q\":\"orders\"}",
        "model tool s1 save {\"doc\":\"draft\"}",
        "model tool p1 publish {\"doc\":\"draft\"}",
        "stop tool",
        "user result q1 ok \"3건\"",
        "user result s1 ok \"초안을 저장했다\"",
        "user result p1 error \"not allowed: publish\"",
        "turn 2 messages=3 limit=1000",
        "model text \"저장은 했고 게시는 막혔다.\"",
        "stop end",
        "done end \"저장은 했고 게시는 막혔다.\"",
        "error bad_field",
        "user text \"다시 저장하고 게시해 줘\"",
        "turn 1 messages=5 limit=1000",
        "model tool s2 save {\"doc\":\"draft\"}",
        "model tool p2 publish {\"doc\":\"draft\"}",
        "stop tool",
        "user result s2 error \"not allowed: save\"",
        "user result p2 ok \"초안을 게시했다\"",
        "turn 2 messages=7 limit=1000",
        "model text \"게시는 했고 저장은 막혔다.\"",
        "stop end",
        "done end \"게시는 했고 저장은 막혔다.\"",
        "user text \"저장만 해 줘\"",
        "turn 1 messages=9 limit=1000",
        "model tool s3 save {\"doc\":\"draft\"}",
        "stop tool",
        "user result s3 ok \"초안을 저장했다\"",
        "turn 2 messages=11 limit=1000",
        "model text \"저장했다.\"",
        "stop end",
        "done end \"저장했다.\"",
        "audit 8",
        "log 1 confirm publish {\"doc\":\"draft\"}",
        "log 2 run q1 read_db {\"q\":\"orders\"}",
        "log 3 run s1 save {\"doc\":\"draft\"}",
        "log 4 deny p1 publish not_allowed {\"doc\":\"draft\"}",
        "log 5 expire publish {\"doc\":\"draft\"}",
        "log 6 deny s2 save not_allowed {\"doc\":\"draft\"}",
        "log 7 run p2 publish {\"doc\":\"draft\"}",
        "log 8 run s3 save {\"doc\":\"draft\"}"
      ]
    },
    {
      "name": "irreversible-confirmation",
      "refs": [
        "4.12",
        "4.7",
        "4.20",
        "4.21"
      ],
      "quote": "맞는 확인이 여럿이면 confirm 을 먼저 한 확인을 쓴다.",
      "input": [
        "config {\"allow\":[\"refund\"]}",
        "tool {\"name\":\"refund\",\"level\":\"irreversible\"}",
        "tool {\"name\":\"wipe\",\"level\":\"irreversible\"}",
        "fake {\"tool\":\"refund\",\"input\":{\"order\":7,\"amount\":5000},\"output\":\"7번 주문에 5000원을 환불했다\"}",
        "fake {\"tool\":\"refund\",\"input\":{\"order\":8,\"amount\":3000},\"output\":\"8번 주문에 3000원을 환불했다\"}",
        "fake {\"tool\":\"wipe\",\"input\":{\"disk\":\"tmp\"},\"output\":\"tmp 디스크를 지웠다\"}",
        "confirm {\"tool\":\"wipe\",\"input\":{\"disk\":\"tmp\"}}",
        "confirm {\"tool\":\"refund\",\"input\":{\"amount\":5e3,\"order\":7}}",
        "confirm {\"tool\":\"refund\",\"input\":{\"order\":7,\"amount\":5000.0}}",
        "confirm {\"tool\":\"refund\",\"input\":{\"order\":8,\"amount\":3000,\"memo\":\"고객 요청\"}}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"x1\",\"name\":\"wipe\",\"input\":{\"disk\":\"tmp\"}},{\"type\":\"tool\",\"id\":\"f1\",\"name\":\"refund\",\"input\":{\"order\":7,\"amount\":5000}},{\"type\":\"tool\",\"id\":\"f2\",\"name\":\"refund\",\"input\":{\"order\":8,\"amount\":3000}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"7번만 환불했다.\"}]}",
        "ask {\"text\":\"임시 디스크를 비우고 7번과 8번 주문을 환불해 줘\"}",
        "audit {\"tool\":\"refund\"}",
        "audit {}"
      ],
      "expected": [
        "user text \"임시 디스크를 비우고 7번과 8번 주문을 환불해 줘\"",
        "turn 1 messages=1 limit=1000",
        "model tool x1 wipe {\"disk\":\"tmp\"}",
        "model tool f1 refund {\"order\":7,\"amount\":5000}",
        "model tool f2 refund {\"order\":8,\"amount\":3000}",
        "stop tool",
        "user result x1 error \"not allowed: wipe\"",
        "user result f1 ok \"7번 주문에 5000원을 환불했다\"",
        "user result f2 error \"confirmation required: refund\"",
        "turn 2 messages=3 limit=1000",
        "model text \"7번만 환불했다.\"",
        "stop end",
        "done end \"7번만 환불했다.\"",
        "audit 7",
        "log 2 confirm refund {\"amount\":5e3,\"order\":7}",
        "log 3 confirm refund {\"order\":7,\"amount\":5000.0}",
        "log 4 confirm refund {\"order\":8,\"amount\":3000,\"memo\":\"고객 요청\"}",
        "log 6 run f1 refund {\"order\":7,\"amount\":5000}",
        "log 7 deny f2 refund unconfirmed {\"order\":8,\"amount\":3000}",
        "log 9 expire refund {\"order\":7,\"amount\":5000.0}",
        "log 10 expire refund {\"order\":8,\"amount\":3000,\"memo\":\"고객 요청\"}",
        "audit 10",
        "log 1 confirm wipe {\"disk\":\"tmp\"}",
        "log 2 confirm refund {\"amount\":5e3,\"order\":7}",
        "log 3 confirm refund {\"order\":7,\"amount\":5000.0}",
        "log 4 confirm refund {\"order\":8,\"amount\":3000,\"memo\":\"고객 요청\"}",
        "log 5 deny x1 wipe not_allowed {\"disk\":\"tmp\"}",
        "log 6 run f1 refund {\"order\":7,\"amount\":5000}",
        "log 7 deny f2 refund unconfirmed {\"order\":8,\"amount\":3000}",
        "log 8 expire wipe {\"disk\":\"tmp\"}",
        "log 9 expire refund {\"order\":7,\"amount\":5000.0}",
        "log 10 expire refund {\"order\":8,\"amount\":3000,\"memo\":\"고객 요청\"}"
      ]
    },
    {
      "name": "confirmation-lifetime",
      "refs": [
        "4.8",
        "4.18",
        "4.21",
        "4.24"
      ],
      "quote": "오류를 낸 ask 는 루프를 실행하지 않으므로 확인을 버리지 않는다.",
      "input": [
        "config {\"allow\":[\"pay\"]}",
        "tool {\"name\":\"pay\",\"level\":\"irreversible\"}",
        "fake {\"tool\":\"pay\",\"input\":{\"order\":1},\"output\":\"1번 주문을 결제했다\"}",
        "confirm {\"tool\":\"pay\",\"input\":{\"order\":1}}",
        "ask {\"text\":}",
        "ask {\"text\":1}",
        "reset",
        "audit {}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"c1\",\"name\":\"pay\",\"input\":{\"order\":1}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"결제했다.\"}]}",
        "ask {\"text\":\"1번 주문을 결제해 줘\"}",
        "confirm {\"tool\":\"pay\",\"input\":{\"order\":1}}",
        "ask {\"text\":\"   \"}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"c2\",\"name\":\"pay\",\"input\":{\"order\":1}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"확인이 없어 결제하지 못했다.\"}]}",
        "ask {\"text\":\"한 번 더 결제해 줘\"}",
        "confirm {\"tool\":\"pay\",\"input\":{\"order\":1}}",
        "config {\"max_turns\":1}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"c3\",\"name\":\"pay\",\"input\":{\"order\":1}}]}",
        "ask {\"text\":\"다시 결제해 줘\"}",
        "config {\"max_turns\":10}",
        "confirm {\"tool\":\"pay\",\"input\":{\"order\":1}}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"c4\",\"name\":\"pay\",\"input\":{\"order\":9}}]}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"c5\",\"name\":\"pay\",\"input\":{\"order\":1}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"1번 주문을 결제했다.\"}]}",
        "ask {\"text\":\"이번에는 결제해 줘\"}",
        "audit {}"
      ],
      "expected": [
        "error bad_json",
        "error bad_field",
        "audit 1",
        "log 1 confirm pay {\"order\":1}",
        "user text \"1번 주문을 결제해 줘\"",
        "turn 1 messages=1 limit=1000",
        "model tool c1 pay {\"order\":1}",
        "stop tool",
        "user result c1 ok \"1번 주문을 결제했다\"",
        "turn 2 messages=3 limit=1000",
        "model text \"결제했다.\"",
        "stop end",
        "done end \"결제했다.\"",
        "user text \"   \"",
        "turn 1 messages=5 limit=1000",
        "reject empty_content",
        "done rejected \"\"",
        "user text \"한 번 더 결제해 줘\"",
        "turn 1 messages=1 limit=1000",
        "model tool c2 pay {\"order\":1}",
        "stop tool",
        "user result c2 error \"confirmation required: pay\"",
        "turn 2 messages=3 limit=1000",
        "model text \"확인이 없어 결제하지 못했다.\"",
        "stop end",
        "done end \"확인이 없어 결제하지 못했다.\"",
        "user text \"다시 결제해 줘\"",
        "turn 1 messages=5 limit=1000",
        "model tool c3 pay {\"order\":1}",
        "stop tool",
        "done max_turns \"\"",
        "user result c3 error \"not executed\"",
        "user text \"이번에는 결제해 줘\"",
        "turn 1 messages=7 limit=1000",
        "model tool c4 pay {\"order\":9}",
        "stop tool",
        "user result c4 error \"no result for this input\"",
        "turn 2 messages=9 limit=1000",
        "model tool c5 pay {\"order\":1}",
        "stop tool",
        "user result c5 ok \"1번 주문을 결제했다\"",
        "turn 3 messages=11 limit=1000",
        "model text \"1번 주문을 결제했다.\"",
        "stop end",
        "done end \"1번 주문을 결제했다.\"",
        "audit 9",
        "log 1 confirm pay {\"order\":1}",
        "log 2 run c1 pay {\"order\":1}",
        "log 3 confirm pay {\"order\":1}",
        "log 4 expire pay {\"order\":1}",
        "log 5 deny c2 pay unconfirmed {\"order\":1}",
        "log 6 confirm pay {\"order\":1}",
        "log 7 expire pay {\"order\":1}",
        "log 8 confirm pay {\"order\":1}",
        "log 9 run c5 pay {\"order\":1}"
      ]
    },
    {
      "name": "leftover-confirmations",
      "refs": [
        "4.21",
        "4.8",
        "4.12"
      ],
      "quote": "expire 항목은 ask 의 done 줄을 출력한 뒤에 생기고 버리는 확인을 confirm 을 한 순서대로 남긴다.",
      "input": [
        "config {\"allow\":[\"refund\",\"drop_table\"]}",
        "tool {\"name\":\"refund\",\"level\":\"irreversible\"}",
        "tool {\"name\":\"drop_table\",\"level\":\"irreversible\"}",
        "fake {\"tool\":\"refund\",\"input\":{\"order\":7},\"output\":\"7번 주문을 환불했다\"}",
        "confirm {\"tool\":\"refund\",\"input\":{\"order\":7}}",
        "confirm {\"tool\":\"drop_table\",\"input\":{\"table\":\"tmp\"}}",
        "confirm {\"tool\":\"refund\",\"input\":{\"order\":8}}",
        "confirm {\"tool\":\"refund\",\"input\":{\"order\":7.0}}",
        "confirm {\"tool\":\"drop_table\",\"input\":{\"table\":\"tmp\"}}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"f1\",\"name\":\"refund\",\"input\":{\"order\":7}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"7번 주문을 환불했다.\"}]}",
        "ask {\"text\":\"7번 주문을 환불해 줘\"}",
        "audit {}"
      ],
      "expected": [
        "user text \"7번 주문을 환불해 줘\"",
        "turn 1 messages=1 limit=1000",
        "model tool f1 refund {\"order\":7}",
        "stop tool",
        "user result f1 ok \"7번 주문을 환불했다\"",
        "turn 2 messages=3 limit=1000",
        "model text \"7번 주문을 환불했다.\"",
        "stop end",
        "done end \"7번 주문을 환불했다.\"",
        "audit 10",
        "log 1 confirm refund {\"order\":7}",
        "log 2 confirm drop_table {\"table\":\"tmp\"}",
        "log 3 confirm refund {\"order\":8}",
        "log 4 confirm refund {\"order\":7.0}",
        "log 5 confirm drop_table {\"table\":\"tmp\"}",
        "log 6 run f1 refund {\"order\":7}",
        "log 7 expire drop_table {\"table\":\"tmp\"}",
        "log 8 expire refund {\"order\":8}",
        "log 9 expire refund {\"order\":7.0}",
        "log 10 expire drop_table {\"table\":\"tmp\"}"
      ]
    },
    {
      "name": "one-confirmation-per-run",
      "refs": [
        "4.13",
        "4.3",
        "4.7",
        "4.21"
      ],
      "quote": "쓴 확인은 그 블록의 실행이 실패하거나 시간 초과로 끝나도 다시 쓰이지 않는다.",
      "input": [
        "config {\"allow\":[\"charge\",\"post\"],\"timeout_ms\":300,\"retries\":2,\"trace\":true}",
        "tool {\"name\":\"charge\",\"level\":\"irreversible\",\"side_effect\":false}",
        "tool {\"name\":\"post\",\"level\":\"write\"}",
        "tool {\"name\":\"price\"}",
        "fake {\"tool\":\"charge\",\"input\":{\"order\":5},\"attempts\":[{\"error\":\"카드사 응답 오류\",\"ms\":100},{\"output\":\"5번 주문을 결제했다\",\"ms\":50}]}",
        "fake {\"tool\":\"charge\",\"input\":{\"order\":6},\"output\":\"6번 주문을 결제했다\",\"ms\":500}",
        "fake {\"tool\":\"post\",\"input\":{\"msg\":\"공지\"},\"attempts\":[{\"error\":\"busy\",\"ms\":20},{\"output\":\"공지를 올렸다\",\"ms\":20}]}",
        "fake {\"tool\":\"price\",\"input\":{\"sku\":\"A\"},\"attempts\":[{\"error\":\"busy\",\"ms\":10},{\"output\":\"1200원\",\"ms\":10}]}",
        "confirm {\"tool\":\"charge\",\"input\":{\"order\":5}}",
        "confirm {\"tool\":\"charge\",\"input\":{\"order\":6}}",
        "confirm {\"tool\":\"charge\",\"input\":{\"order\":6}}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"a1\",\"name\":\"charge\",\"input\":{\"order\":5}},{\"type\":\"tool\",\"id\":\"b1\",\"name\":\"charge\",\"input\":{\"order\":6}},{\"type\":\"tool\",\"id\":\"b2\",\"name\":\"charge\",\"input\":{\"order\":6}},{\"type\":\"tool\",\"id\":\"b3\",\"name\":\"charge\",\"input\":{\"order\":6}},{\"type\":\"tool\",\"id\":\"m1\",\"name\":\"post\",\"input\":{\"msg\":\"공지\"}},{\"type\":\"tool\",\"id\":\"p1\",\"name\":\"price\",\"input\":{\"sku\":\"A\"}}]}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"text\",\"text\":\"5번 결제를 다시 시도한다.\"},{\"type\":\"tool\",\"id\":\"a2\",\"name\":\"charge\",\"input\":{\"order\":5}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"결제 결과를 확인해야 한다.\"}]}",
        "ask {\"text\":\"5번과 6번 주문을 결제하고 공지를 올려 줘\"}",
        "audit {\"tool\":\"charge\"}"
      ],
      "expected": [
        "user text \"5번과 6번 주문을 결제하고 공지를 올려 줘\"",
        "turn 1 messages=1 limit=1000",
        "model tool a1 charge {\"order\":5}",
        "model tool b1 charge {\"order\":6}",
        "model tool b2 charge {\"order\":6}",
        "model tool b3 charge {\"order\":6}",
        "model tool m1 post {\"msg\":\"공지\"}",
        "model tool p1 price {\"sku\":\"A\"}",
        "stop tool",
        "exec m1 0 20 error 1",
        "exec p1 20 40 ok 2",
        "exec a1 0 100 error 1",
        "exec b1 0 300 timeout 1",
        "exec b2 0 300 timeout 1",
        "clock 300",
        "user result a1 error \"카드사 응답 오류\"",
        "user result b1 error \"timeout after 300 ms; outcome unknown\"",
        "user result b2 error \"timeout after 300 ms; outcome unknown\"",
        "user result b3 error \"confirmation required: charge\"",
        "user result m1 error \"busy\"",
        "user result p1 ok \"1200원\"",
        "turn 2 messages=3 limit=1000",
        "model text \"5번 결제를 다시 시도한다.\"",
        "model tool a2 charge {\"order\":5}",
        "stop tool",
        "clock 0",
        "user result a2 error \"confirmation required: charge\"",
        "turn 3 messages=5 limit=1000",
