      "expected": [
        "user text \"계산\"",
        "turn 1 messages=1 limit=1000",
        "reject tool_schema",
        "done rejected \"\"",
        "user text \"계산\"",
        "turn 1 messages=1 limit=1000",
        "reject tool_schema",
        "done rejected \"\"",
        "user text \"계산\"",
        "turn 1 messages=1 limit=1000",
        "reject tool_schema",
        "done rejected \"\"",
        "user text \"계산\"",
        "turn 1 messages=1 limit=1000",
        "reject tool_schema",
