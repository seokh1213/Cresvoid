{
  "timeout_sec": 10,
  "tests": [
    {
      "name": "schema-basic",
      "refs": [
        "1.1",
        "4.13",
        "4.15",
        "4.19"
      ],
      "quote": "도구 정의가 있고 그 정의에 schema 가 있으면 블록의 input 을 schema 로 검증한다.",
      "input": [
        "tool {\"name\":\"weather\",\"schema\":{\"type\":\"object\",\"properties\":{\"city\":{\"type\":\"string\"}},\"required\":[\"city\"]}}",
        "fake {\"tool\":\"weather\",\"input\":{\"city\":\"서울\"},\"output\":\"맑음\"}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"w1\",\"name\":\"weather\",\"input\":{}},{\"type\":\"tool\",\"id\":\"w2\",\"name\":\"weather\",\"input\":{\"city\":3}}]}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"w3\",\"name\":\"weather\",\"input\":{\"city\":\"서울\"}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"서울은 맑다.\"}]}",
        "ask {\"text\":\"날씨 알려 줘\"}"
      ],
      "expected": [
        "user text \"날씨 알려 줘\"",
        "turn 1 messages=1 limit=1000",
        "model tool w1 weather {}",
        "model tool w2 weather {\"city\":3}",
        "stop tool",
        "user result w1 error \"invalid input: /city required\"",
        "user result w2 error \"invalid input: /city expected string\"",
        "turn 2 messages=3 limit=1000",
        "model tool w3 weather {\"city\":\"서울\"}",
        "stop tool",
        "user result w3 ok \"맑음\"",
        "turn 3 messages=5 limit=1000",
        "model text \"서울은 맑다.\"",
        "stop end",
        "done end \"서울은 맑다.\""
      ]
    },
    {
      "name": "type-keyword",
      "refs": [
        "4.15",
        "2.4",
        "4.20"
      ],
      "quote": "v 가 type 에 맞지 않으면 오류 `<p> expected <type>` 을 내고 이 s 와 v 의 검증을 여기서 끝낸다.",
      "input": [
        "tool {\"name\":\"kinds\",\"schema\":{\"type\":\"object\",\"properties\":{\"o\":{\"type\":\"object\",\"required\":[\"k\"]},\"a\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"s\":{\"type\":\"string\",\"enum\":[\"x\"]},\"i\":{\"type\":\"integer\",\"minimum\":10},\"n\":{\"type\":\"number\",\"maximum\":1},\"b\":{\"type\":\"boolean\"},\"z\":{\"type\":\"null\"}}}}",
        "fake {\"tool\":\"kinds\",\"input\":{\"o\":{\"k\":1},\"a\":[\"p\"],\"s\":\"x\",\"i\":100,\"n\":-0.5,\"b\":false,\"z\":null},\"output\":\"모두 통과\"}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"k1\",\"name\":\"kinds\",\"input\":{\"z\":null,\"b\":false,\"n\":-0.5,\"i\":1E2,\"s\":\"x\",\"a\":[\"p\"],\"o\":{\"k\":1.0}}},{\"type\":\"tool\",\"id\":\"k2\",\"name\":\"kinds\",\"input\":{\"z\":false,\"b\":0,\"n\":\"1\",\"i\":10.5,\"s\":1,\"a\":{},\"o\":[]}},{\"type\":\"tool\",\"id\":\"k3\",\"name\":\"kinds\",\"input\":{\"s\":2,\"i\":2.5,\"o\":\"k\"}},{\"type\":\"tool\",\"id\":\"k4\",\"name\":\"kinds\",\"input\":{\"i\":10.0}},{\"type\":\"tool\",\"id\":\"k5\",\"name\":\"kinds\",\"input\":{\"i\":-0,\"n\":2}},{\"type\":\"tool\",\"id\":\"k6\",\"name\":\"kinds\",\"input\":{\"n\":1,\"i\":9.99e1}},{\"type\":\"tool\",\"id\":\"k7\",\"name\":\"kinds\",\"input\":{\"a\":[\"p\",1,null],\"o\":{}}},{\"type\":\"tool\",\"id\":\"k8\",\"name\":\"kinds\",\"input\":{\"b\":true,\"z\":null,\"extra\":1}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"종류를 확인했다.\"}]}",
        "ask {\"text\":\"값의 종류를 확인해 줘\"}"
      ],
      "expected": [
        "user text \"값의 종류를 확인해 줘\"",
        "turn 1 messages=1 limit=1000",
        "model tool k1 kinds {\"z\":null,\"b\":false,\"n\":-0.5,\"i\":1E2,\"s\":\"x\",\"a\":[\"p\"],\"o\":{\"k\":1.0}}",
        "model tool k2 kinds {\"z\":false,\"b\":0,\"n\":\"1\",\"i\":10.5,\"s\":1,\"a\":{},\"o\":[]}",
        "model tool k3 kinds {\"s\":2,\"i\":2.5,\"o\":\"k\"}",
        "model tool k4 kinds {\"i\":10.0}",
        "model tool k5 kinds {\"i\":-0,\"n\":2}",
        "model tool k6 kinds {\"n\":1,\"i\":9.99e1}",
        "model tool k7 kinds {\"a\":[\"p\",1,null],\"o\":{}}",
        "model tool k8 kinds {\"b\":true,\"z\":null,\"extra\":1}",
        "stop tool",
        "user result k1 ok \"모두 통과\"",
        "user result k2 error \"invalid input: /o expected object; /a expected array; /s expected string; /i expected integer; /n expected number; /b expected boolean; /z expected null\"",
        "user result k3 error \"invalid input: /o expected object; /s expected string; /i expected integer\"",
        "user result k4 error \"no result for this input\"",
        "user result k5 error \"invalid input: /i below minimum 10; /n above maximum 1\"",
        "user result k6 error \"invalid input: /i expected integer\"",
        "user result k7 error \"invalid input: /o/k required; /a/1 expected string; /a/2 expected string\"",
        "user result k8 error \"no result for this input\"",
        "turn 2 messages=3 limit=1000",
        "model text \"종류를 확인했다.\"",
        "stop end",
        "done end \"종류를 확인했다.\""
      ]
    },
    {
      "name": "enum-keyword",
      "refs": [
        "4.16",
        "2.4",
        "4.8"
      ],
      "quote": "s 에 enum 이 있고 v 가 enum 의 어떤 원소와도 같지 않으면 오류 `<p> not in enum` 을 낸다.",
      "input": [
        "tool {\"name\":\"pick\",\"schema\":{\"type\":\"object\",\"properties\":{\"mode\":{\"enum\":[\"fast\",\"slow\",\"fast\"]},\"level\":{\"type\":\"integer\",\"enum\":[1,2,3]},\"shape\":{\"enum\":[{\"w\":1,\"h\":[2,3]},null,true,\"1\"]},\"big\":{\"enum\":[12345678901234567890]},\"frac\":{\"enum\":[0.1]}}}}",
        "fake {\"tool\":\"pick\",\"input\":{\"mode\":\"fast\",\"level\":2,\"shape\":{\"w\":1,\"h\":[2,3]}},\"output\":\"선택됨\"}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"e1\",\"name\":\"pick\",\"input\":{\"shape\":{\"h\":[2.0,3e0],\"w\":1},\"level\":2.0,\"mode\":\"fast\"}},{\"type\":\"tool\",\"id\":\"e2\",\"name\":\"pick\",\"input\":{\"mode\":\"FAST\",\"level\":4,\"shape\":1}},{\"type\":\"tool\",\"id\":\"e3\",\"name\":\"pick\",\"input\":{\"shape\":null,\"big\":1.2345678901234567890E19,\"frac\":1e-1}},{\"type\":\"tool\",\"id\":\"e4\",\"name\":\"pick\",\"input\":{\"big\":12345678901234567891,\"frac\":0.10000000000000001}},{\"type\":\"tool\",\"id\":\"e5\",\"name\":\"pick\",\"input\":{\"shape\":{\"w\":1,\"h\":[3,2]}}},{\"type\":\"tool\",\"id\":\"e6\",\"name\":\"pick\",\"input\":{\"shape\":{\"w\":1,\"h\":[2,3],\"d\":0}}},{\"type\":\"tool\",\"id\":\"e7\",\"name\":\"pick\",\"input\":{\"shape\":\"1\",\"mode\":\"slow\"}},{\"type\":\"tool\",\"id\":\"e8\",\"name\":\"pick\",\"input\":{\"shape\":true,\"level\":\"2\"}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"하나만 골랐다.\"}]}",
        "ask {\"text\":\"골라 줘\"}"
      ],
      "expected": [
        "user text \"골라 줘\"",
        "turn 1 messages=1 limit=1000",
        "model tool e1 pick {\"shape\":{\"h\":[2.0,3e0],\"w\":1},\"level\":2.0,\"mode\":\"fast\"}",
        "model tool e2 pick {\"mode\":\"FAST\",\"level\":4,\"shape\":1}",
        "model tool e3 pick {\"shape\":null,\"big\":1.2345678901234567890E19,\"frac\":1e-1}",
        "model tool e4 pick {\"big\":12345678901234567891,\"frac\":0.10000000000000001}",
        "model tool e5 pick {\"shape\":{\"w\":1,\"h\":[3,2]}}",
        "model tool e6 pick {\"shape\":{\"w\":1,\"h\":[2,3],\"d\":0}}",
        "model tool e7 pick {\"shape\":\"1\",\"mode\":\"slow\"}",
        "model tool e8 pick {\"shape\":true,\"level\":\"2\"}",
        "stop tool",
        "user result e1 ok \"선택됨\"",
        "user result e2 error \"invalid input: /mode not in enum; /level not in enum; /shape not in enum\"",
        "user result e3 error \"no result for this input\"",
        "user result e4 error \"invalid input: /big not in enum; /frac not in enum\"",
        "user result e5 error \"invalid input: /shape not in enum\"",
        "user result e6 error \"invalid input: /shape not in enum\"",
        "user result e7 error \"no result for this input\"",
        "user result e8 error \"invalid input: /level expected integer\"",
        "turn 2 messages=3 limit=1000",
        "model text \"하나만 골랐다.\"",
        "stop end",
        "done end \"하나만 골랐다.\""
      ]
    },
    {
      "name": "minimum-maximum",
      "refs": [
        "4.17",
        "4.18",
        "2.3",
        "4.9"
      ],
      "quote": "오류에 적는 minimum 과 maximum 은 스키마에 쓰인 글자 그대로다.",
      "input": [
        "tool {\"name\":\"measure\",\"schema\":{\"type\":\"object\",\"properties\":{\"qty\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":1E2},\"rate\":{\"minimum\":0.30000000000000001,\"maximum\":-0},\"temp\":{\"type\":\"number\",\"minimum\":-273.15},\"code\":{\"minimum\":3,\"enum\":[\"a\",5]},\"pct\":{\"maximum\":100.0}}}}",
        "fake {\"tool\":\"measure\",\"input\":{\"qty\":1,\"temp\":-273.15,\"pct\":100},\"output\":\"기록됨\"}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"m1\",\"name\":\"measure\",\"input\":{\"qty\":1,\"temp\":-273.15,\"pct\":100}},{\"type\":\"tool\",\"id\":\"m2\",\"name\":\"measure\",\"input\":{\"qty\":0}},{\"type\":\"tool\",\"id\":\"m3\",\"name\":\"measure\",\"input\":{\"qty\":101}},{\"type\":\"tool\",\"id\":\"m4\",\"name\":\"measure\",\"input\":{\"qty\":100.0}},{\"type\":\"tool\",\"id\":\"m5\",\"name\":\"measure\",\"input\":{\"rate\":0.3}},{\"type\":\"tool\",\"id\":\"m6\",\"name\":\"measure\",\"input\":{\"rate\":-1}},{\"type\":\"tool\",\"id\":\"m7\",\"name\":\"measure\",\"input\":{\"rate\":0}},{\"type\":\"tool\",\"id\":\"m8\",\"name\":\"measure\",\"input\":{\"rate\":\"x\",\"pct\":\"200\"}},{\"type\":\"tool\",\"id\":\"m9\",\"name\":\"measure\",\"input\":{\"code\":1}},{\"type\":\"tool\",\"id\":\"m10\",\"name\":\"measure\",\"input\":{\"code\":\"a\"}},{\"type\":\"tool\",\"id\":\"m11\",\"name\":\"measure\",\"input\":{\"temp\":-273.16}},{\"type\":\"tool\",\"id\":\"m12\",\"name\":\"measure\",\"input\":{\"pct\":1e3}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"측정값을 확인했다.\"}]}",
        "ask {\"text\":\"측정값을 기록해 줘\"}"
      ],
      "expected": [
        "user text \"측정값을 기록해 줘\"",
        "turn 1 messages=1 limit=1000",
        "model tool m1 measure {\"qty\":1,\"temp\":-273.15,\"pct\":100}",
        "model tool m2 measure {\"qty\":0}",
        "model tool m3 measure {\"qty\":101}",
        "model tool m4 measure {\"qty\":100.0}",
        "model tool m5 measure {\"rate\":0.3}",
        "model tool m6 measure {\"rate\":-1}",
        "model tool m7 measure {\"rate\":0}",
        "model tool m8 measure {\"rate\":\"x\",\"pct\":\"200\"}",
        "model tool m9 measure {\"code\":1}",
        "model tool m10 measure {\"code\":\"a\"}",
        "model tool m11 measure {\"temp\":-273.16}",
        "model tool m12 measure {\"pct\":1e3}",
        "stop tool",
        "user result m1 ok \"기록됨\"",
        "user result m2 error \"invalid input: /qty below minimum 1\"",
        "user result m3 error \"invalid input: /qty above maximum 1E2\"",
        "user result m4 error \"no result for this input\"",
        "user result m5 error \"invalid input: /rate below minimum 0.30000000000000001; /rate above maximum -0\"",
        "user result m6 error \"invalid input: /rate below minimum 0.30000000000000001\"",
        "user result m7 error \"invalid input: /rate below minimum 0.30000000000000001\"",
        "user result m8 error \"no result for this input\"",
        "user result m9 error \"invalid input: /code not in enum; /code below minimum 3\"",
        "user result m10 error \"no result for this input\"",
        "user result m11 error \"invalid input: /temp below minimum -273.15\"",
        "user result m12 error \"invalid input: /pct above maximum 100.0\"",
        "turn 2 messages=3 limit=1000",
        "model text \"측정값을 확인했다.\"",
        "stop end",
        "done end \"측정값을 확인했다.\""
      ]
    },
    {
      "name": "required-and-properties",
      "refs": [
        "4.19",
        "4.20",
        "4.22",
        "2.5",
        "4.7"
      ],
      "quote": "그래서 오류는 바깥 값의 enum, minimum, maximum, required 오류, 안쪽 필드와 원소의 오류 순서로 나온다.",
      "input": [
        "tool {\"name\":\"order\",\"schema\":{\"type\":\"object\",\"required\":[\"b\",\"a\",\"zz\"],\"properties\":{\"a\":{\"type\":\"string\"},\"b\":{\"type\":\"object\",\"required\":[\"y\",\"x\"],\"properties\":{\"x\":{\"type\":\"integer\"},\"y\":{\"type\":\"integer\"}}},\"c\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[]}}}}}",
        "fake {\"tool\":\"order\",\"input\":{\"a\":\"s\",\"b\":{\"x\":1,\"y\":2},\"zz\":[]},\"output\":\"주문됨\"}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"r1\",\"name\":\"order\",\"input\":{}},{\"type\":\"tool\",\"id\":\"r2\",\"name\":\"order\",\"input\":{\"zz\":0,\"b\":{\"x\":\"1\"},\"a\":1}},{\"type\":\"tool\",\"id\":\"r3\",\"name\":\"order\",\"input\":{\"a\":\"s\",\"b\":{\"y\":1.5,\"x\":2},\"zz\":null,\"c\":[{},{\"q\":1}]}},{\"type\":\"tool\",\"id\":\"r4\",\"name\":\"order\",\"input\":{\"a\":\"s\",\"b\":{\"x\":1,\"y\":2,\"w\":3},\"zz\":[],\"extra\":{\"deep\":true}}},{\"type\":\"tool\",\"id\":\"r5\",\"name\":\"order\",\"input\":{\"zz\":[],\"a\":\"s\",\"b\":{\"y\":2,\"x\":1}}},{\"type\":\"tool\",\"id\":\"r6\",\"name\":\"order\",\"input\":{\"a\":\"s\",\"b\":[],\"zz\":1,\"c\":[1,{}]}},{\"type\":\"tool\",\"id\":\"r7\",\"name\":\"order\",\"input\":{\"b\":{\"x\":\"1\"}}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"주문을 넣었다.\"}]}",
        "ask {\"text\":\"주문해 줘\"}"
      ],
      "expected": [
        "user text \"주문해 줘\"",
        "turn 1 messages=1 limit=1000",
        "model tool r1 order {}",
        "model tool r2 order {\"zz\":0,\"b\":{\"x\":\"1\"},\"a\":1}",
        "model tool r3 order {\"a\":\"s\",\"b\":{\"y\":1.5,\"x\":2},\"zz\":null,\"c\":[{},{\"q\":1}]}",
        "model tool r4 order {\"a\":\"s\",\"b\":{\"x\":1,\"y\":2,\"w\":3},\"zz\":[],\"extra\":{\"deep\":true}}",
        "model tool r5 order {\"zz\":[],\"a\":\"s\",\"b\":{\"y\":2,\"x\":1}}",
        "model tool r6 order {\"a\":\"s\",\"b\":[],\"zz\":1,\"c\":[1,{}]}",
        "model tool r7 order {\"b\":{\"x\":\"1\"}}",
        "stop tool",
        "user result r1 error \"invalid input: /b required; /a required; /zz required\"",
        "user result r2 error \"invalid input: /a expected string; /b/y required; /b/x expected integer\"",
        "user result r3 error \"invalid input: /b/y expected integer\"",
        "user result r4 error \"no result for this input\"",
        "user result r5 ok \"주문됨\"",
        "user result r6 error \"invalid input: /b expected object; /c/0 expected object\"",
        "user result r7 error \"invalid input: /a required; /zz required; /b/y required; /b/x expected integer\"",
        "turn 2 messages=3 limit=1000",
        "model text \"주문을 넣었다.\"",
        "stop end",
        "done end \"주문을 넣었다.\""
      ]
    },
    {
      "name": "paths-and-items",
      "refs": [
        "3.2",
        "4.21",
        "4.19"
      ],
      "quote": "필드 이름은 바꾸지 않고 그대로 붙인다.",
      "input": [
        "tool {\"name\":\"map\",\"schema\":{\"type\":\"object\",\"properties\":{\"grid\":{\"type\":\"array\",\"items\":{\"type\":\"array\",\"items\":{\"type\":\"integer\",\"maximum\":9}}},\"a/b\":{\"type\":\"string\"},\"\":{\"type\":\"boolean\"},\"공백 있는 이름\":{\"type\":\"null\"},\"q\\\"t\":{\"type\":\"number\"}},\"required\":[\"필수\",\"\"]}}",
        "fake {\"tool\":\"map\",\"input\":{\"필수\":true,\"grid\":[[]],\"\":false},\"output\":\"지도\"}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"p1\",\"name\":\"map\",\"input\":{\"grid\":[[1,2],[3,10,\"x\"],5],\"a/b\":1,\"\":\"no\",\"공백 있는 이름\":0,\"q\\\"t\":\"n\",\"필수\":1}},{\"type\":\"tool\",\"id\":\"p2\",\"name\":\"map\",\"input\":{\"grid\":[]}},{\"type\":\"tool\",\"id\":\"p3\",\"name\":\"map\",\"input\":{\"\":false,\"grid\":[[]],\"필수\":true}},{\"type\":\"tool\",\"id\":\"p4\",\"name\":\"map\",\"input\":{\"grid\":[[9,0],[]],\"필수\":null,\"\":true,\"a/b\":\"x/y\"}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"지도를 그렸다.\"}]}",
        "ask {\"text\":\"지도를 그려 줘\"}"
      ],
      "expected": [
        "user text \"지도를 그려 줘\"",
        "turn 1 messages=1 limit=1000",
        "model tool p1 map {\"grid\":[[1,2],[3,10,\"x\"],5],\"a/b\":1,\"\":\"no\",\"공백 있는 이름\":0,\"q\\\"t\":\"n\",\"필수\":1}",
        "model tool p2 map {\"grid\":[]}",
        "model tool p3 map {\"\":false,\"grid\":[[]],\"필수\":true}",
        "model tool p4 map {\"grid\":[[9,0],[]],\"필수\":null,\"\":true,\"a/b\":\"x/y\"}",
        "stop tool",
        "user result p1 error \"invalid input: /grid/1/1 above maximum 9; /grid/1/2 expected integer; /grid/2 expected array; /a/b expected string; / expected boolean; /공백 있는 이름 expected null; /q\\\"t expected number\"",
        "user result p2 error \"invalid input: /필수 required; / required\"",
        "user result p3 ok \"지도\"",
        "user result p4 error \"no result for this input\"",
        "turn 2 messages=3 limit=1000",
        "model text \"지도를 그렸다.\"",
        "stop end",
        "done end \"지도를 그렸다.\""
      ]
    },
    {
      "name": "schema-keyword-format",
      "refs": [
        "4.3",
        "4.4",
        "4.5",
        "4.6",
        "4.7",
        "4.8",
        "4.9",
        "4.10",
        "4.12"
      ],
      "quote": "스키마의 필드 이름은 `type`, `description`, `properties`, `required`, `enum`, `minimum`, `maximum`, `items` 가운데 하나여야 한다.",
      "input": [
        "tool {\"name\":\"notes\",\"schema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}}}}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"계산했다.\"}]}",
        "tool {\"name\":\"calc\",\"schema\":{\"type\":\"object\",\"properties\":{\"x\":{\"type\":\"number\"}},\"additionalProperties\":false}}",
        "ask {\"text\":\"계산\"}",
        "tool {\"name\":\"calc\",\"schema\":{\"type\":\"object\",\"properties\":{\"x\":{\"type\":[\"number\",\"null\"]}}}}",
        "ask {\"text\":\"계산\"}",
        "tool {\"name\":\"calc\",\"schema\":{\"type\":\"object\",\"required\":\"x\"}}",
        "ask {\"text\":\"계산\"}",
        "tool {\"name\":\"calc\",\"schema\":{\"type\":\"object\",\"required\":[\"x\",\"x\"]}}",
        "ask {\"text\":\"계산\"}",
        "tool {\"name\":\"calc\",\"schema\":{\"type\":\"object\",\"required\":[\"x\",1]}}",
        "ask {\"text\":\"계산\"}",
        "tool {\"name\":\"calc\",\"schema\":{\"type\":\"object\",\"properties\":{\"x\":{\"enum\":[]}}}}",
        "ask {\"text\":\"계산\"}",
        "tool {\"name\":\"calc\",\"schema\":{\"type\":\"object\",\"properties\":{\"x\":{\"minimum\":\"1\"}}}}",
        "ask {\"text\":\"계산\"}",
        "tool {\"name\":\"calc\",\"schema\":{\"type\":\"object\",\"properties\":{\"x\":{\"maximum\":null}}}}",
        "ask {\"text\":\"계산\"}",
        "tool {\"name\":\"calc\",\"schema\":{\"type\":\"object\",\"properties\":{\"x\":{\"type\":\"array\",\"items\":[{\"type\":\"string\"}]}}}}",
        "ask {\"text\":\"계산\"}",
        "tool {\"name\":\"calc\",\"schema\":{\"type\":\"object\",\"properties\":{\"x\":\"string\"}}}",
        "ask {\"text\":\"계산\"}",
        "tool {\"name\":\"calc\",\"schema\":{\"type\":\"object\",\"properties\":{\"x\":{\"description\":3}}}}",
        "ask {\"text\":\"계산\"}",
        "tool {\"name\":\"calc\",\"schema\":{\"type\":\"object\",\"properties\":{\"x\":{\"properties\":{\"y\":{\"type\":\"int\"}}}}}}",
        "ask {\"text\":\"계산\"}",
        "tool {\"name\":\"calc\",\"schema\":{\"type\":\"object\",\"description\":\"\",\"required\":[],\"properties\":{\"x\":{\"minimum\":5,\"maximum\":1,\"enum\":[1,1,{\"a\":[]}]},\"y\":{\"items\":{}},\"z\":{},\"w\":{\"type\":\"object\",\"required\":[\"v\",\"u\"]}}}}",
        "ask {\"text\":\"계산\"}"
