    {
      "name": "context-window-limit",
      "refs": [
        "4.17",
        "4.18",
        "4.5",
        "4.4"
      ],
      "quote": "context_window 가 1 이상이고 요청의 토큰 수가 context_window 보다 크면 이 규칙을 어긴다.",
      "input": [
        "config {\"context_window\":23}",
        "tool {\"name\":\"echo\"}",
        "fake {\"tool\":\"echo\",\"input\":{\"n\":1},\"output\":\"메아리 하나\"}",
        "fake {\"tool\":\"echo\",\"input\":{\"n\":2},\"output\":\"메아리 둘: 산 너머에서 돌아온 소리가 길게 이어진다\"}",
        "fake {\"tool\":\"echo\",\"input\":{\"n\":3},\"output\":\"메아리 셋\"}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"e1\",\"name\":\"echo\",\"input\":{\"n\":1}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"끝\"}]}",
        "ask {\"text\":\"한도 시험\"}",
        "config {\"context_window\":30}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"남은 응답\"}]}",
        "ask {\"text\":\"다시\"}",
        "ask {\"text\":\"새 대화\"}",
        "config {\"context_window\":5}",
        "ask {\"text\":\"각본 없음\"}",
        "config {\"context_window\":1000}",
        "ask {\"text\":\"각본 없음\"}",
        "config {\"context_window\":40,\"clear_trigger\":35,\"clear_target\":20}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"e2\",\"name\":\"echo\",\"input\":{\"n\":2}}]}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"e3\",\"name\":\"echo\",\"input\":{\"n\":3}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"셋 다 들었다.\"}]}",
        "ask {\"text\":\"메아리\"}"
      ],
      "expected": [
        "user text \"한도 시험\"",
        "turn 1 messages=1 limit=1000",
        "context 9",
        "model tool e1 echo {\"n\":1}",
        "stop tool",
        "user result e1 ok \"메아리 하나\"",
        "turn 2 messages=3 limit=1000",
        "context 23",
        "model text \"끝\"",
        "stop end",
        "done end \"끝\"",
        "user text \"다시\"",
        "turn 1 messages=5 limit=1000",
        "context 31",
        "reject context_window",
        "done rejected \"\"",
        "user text \"새 대화\"",
        "turn 1 messages=1 limit=1000",
        "context 8",
        "model text \"남은 응답\"",
        "stop end",
        "done end \"남은 응답\"",
        "user text \"각본 없음\"",
        "turn 1 messages=3 limit=1000",
        "context 18",
        "reject context_window",
        "done rejected \"\"",
        "user text \"각본 없음\"",
        "turn 1 messages=1 limit=1000",
        "context 9",
        "reject script_exhausted",
        "done rejected \"\"",
        "user text \"메아리\"",
        "turn 1 messages=1 limit=1000",
        "context 8",
        "model tool e2 echo {\"n\":2}",
        "stop tool",
        "user result e2 ok \"메아리 둘: 산 너머에서 돌아온 소리가 길게 이어진다\"",
        "turn 2 messages=3 limit=1000",
        "context 28",
        "model tool e3 echo {\"n\":3}",
        "stop tool",
        "user result e3 ok \"메아리 셋\"",
        "turn 3 messages=5 limit=1000",
        "clear 42 37 e2",
        "context 37",
        "model text \"셋 다 들었다.\"",
        "stop end",
        "done end \"셋 다 들었다.\""
      ]
    },
