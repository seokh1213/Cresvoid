{
  "timeout_sec": 10,
  "tests": [
    {
      "name": "context-line-basic",
      "refs": [
        "4.5",
        "4.1",
        "3.3",
        "4.2"
      ],
      "quote": "context_window 가 1 이상이면 실행기는 차례마다 `context <요청의 토큰 수>` 를 출력한다.",
      "input": [
        "config {\"context_window\":1000}",
        "tool {\"name\":\"lookup\"}",
        "fake {\"tool\":\"lookup\",\"input\":{\"sku\":\"A-1\"},\"output\":\"재고 12개\"}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"u1\",\"name\":\"lookup\",\"input\":{\"sku\":\"A-1\"}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"A-1 은 12개 남았다.\"}]}",
        "ask {\"text\":\"A-1 재고 알려 줘\"}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"천만에.\"}]}",
        "ask {\"text\":\"고마워\"}"
      ],
      "expected": [
        "user text \"A-1 재고 알려 줘\"",
        "turn 1 messages=1 limit=1000",
        "context 11",
        "model tool u1 lookup {\"sku\":\"A-1\"}",
        "stop tool",
        "user result u1 ok \"재고 12개\"",
        "turn 2 messages=3 limit=1000",
        "context 27",
        "model text \"A-1 은 12개 남았다.\"",
        "stop end",
        "done end \"A-1 은 12개 남았다.\"",
        "user text \"고마워\"",
        "turn 1 messages=5 limit=1000",
        "context 38",
        "model text \"천만에.\"",
        "stop end",
        "done end \"천만에.\""
      ]
    },
    {
