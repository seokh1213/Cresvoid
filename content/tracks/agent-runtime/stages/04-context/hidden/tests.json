        "tool {\"name\":\"memo\"}",
        "fake {\"tool\":\"memo\",\"input\":{\"title\":\"주간 회의\",\"tags\":[\"a/b\",\"é\"],\"n\":1.50},\"output\":\"첫 줄\\n둘째 줄 \\\"인용\\\" 끝\\\\\\t탭\\u0001\"}",
        "fake {\"tool\":\"memo\",\"input\":{\"title\":\"쓰지 않는 메모\"},\"output\":\"이 결과는 어떤 도구 사용에도 쓰이지 않으므로 요청에 들어가지 않는다. 이 결과는 어떤 도구 사용에도 쓰이지 않으므로 요청에 들어가지 않는다.\"}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"text\",\"text\":\"메모를 \\\"저장\\\"하겠다 🙂\"},{\"type\":\"tool\",\"id\":\"m1\",\"name\":\"memo\",\"input\":{ \"title\" : \"주간 회의\", \"tags\":[\"a\\/b\",\"\\u00e9\"], \"n\":1.50 }}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"저장했다 🙂🙂🙂🙂\"}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"아직 쓰지 않은 응답도 요청에 들어가지 않는다.\"}]}",
        "ask {\"text\":\"🙂🙂🙂 회의 메모를 남겨 줘\"}",
        "ask {\"text\":\"고마워 \\uD83D\\uDE42\"}"
      ],
      "expected": [
        "user text \"🙂🙂🙂 회의 메모를 남겨 줘\"",
        "turn 1 messages=1 limit=999999",
        "context 11",
        "model text \"메모를 \\\"저장\\\"하겠다 🙂\"",
        "model tool m1 memo {\"title\":\"주간 회의\",\"tags\":[\"a/b\",\"é\"],\"n\":1.50}",
        "stop tool",
        "user result m1 ok \"첫 줄\\n둘째 줄 \\\"인용\\\" 끝\\\\\\t탭\\u0001\"",
        "turn 2 messages=3 limit=999999",
        "context 47",
        "model text \"저장했다 🙂🙂🙂🙂\"",
        "stop end",
        "done end \"저장했다 🙂🙂🙂🙂\"",
        "user text \"고마워 🙂\"",
        "turn 1 messages=5 limit=999999",
        "context 58",
        "model text \"아직 쓰지 않은 응답도 요청에 들어가지 않는다.\"",
        "stop end",
        "done end \"아직 쓰지 않은 응답도 요청에 들어가지 않는다.\""
      ]
