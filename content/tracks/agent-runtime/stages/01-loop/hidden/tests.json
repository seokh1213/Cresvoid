      ],
      "quote": "실행기는 모델을 호출하고 모델이 요청한 도구를 실행한 뒤 그 결과를 다음 호출에 실어 보내는 일을 되풀이한다.",
      "input": [
        "tool {\"name\":\"weather\",\"description\":\"도시의 현재 날씨\"}",
        "fake {\"tool\":\"weather\",\"input\":{\"city\":\"부산\"},\"output\":\"흐림\"}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"무엇을 도와줄까?\"}]}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"text\",\"text\":\"찾아보겠다.\"},{\"type\":\"tool\",\"id\":\"w1\",\"name\":\"weather\",\"input\":{\"city\":\"부산\"}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"부산은 흐리다.\"}]}",
        "ask {\"text\":\"안녕\"}",
        "ask {\"text\":\"부산 날씨는?\"}"
      ],
      "expected": [
        "user text \"안녕\"",
        "turn 1 messages=1 limit=1000",
        "model text \"무엇을 도와줄까?\"",
        "stop end",
        "done end \"무엇을 도와줄까?\"",
        "user text \"부산 날씨는?\"",
        "turn 1 messages=3 limit=1000",
        "model text \"찾아보겠다.\"",
        "model tool w1 weather {\"city\":\"부산\"}",
        "stop tool",
        "user result w1 ok \"흐림\"",
        "turn 2 messages=5 limit=1000",
        "model text \"부산은 흐리다.\"",
        "stop end",
        "done end \"부산은 흐리다.\""
      ]
    },
    {
      "name": "tool-results-in-order",
      "refs": [
        "4.41",
        "4.42",
