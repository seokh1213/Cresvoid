    {
      "name": "reply-limit-retry",
      "refs": [
        "4.38",
        "4.40",
        "4.20",
        "4.26",
        "4.23",
        "2.6"
      ],
      "quote": "둘 다 아니면 응답 한도를 지금 한도의 두 배와 reply_limit_cap 가운데 작은 값으로 바꾸고 다음 차례를 시작한다.",
      "input": [
        "config {\"reply_limit\":3e2,\"reply_limit_cap\":1000.0}",
        "tool {\"name\":\"draft\"}",
        "fake {\"tool\":\"draft\",\"input\":{\"topic\":\"회의\"},\"output\":\"초안 1\"}",
        "reply {\"stop\":\"length\",\"content\":[{\"type\":\"text\",\"text\":\"초안을 쓰겠다.\"},{\"type\":\"tool\",\"id\":\"d1\",\"name\":\"draft\",\"input\":{\"topic\":\"회의\"}},{\"type\":\"tool\",\"id\":\"d2\",\"name\":\"draft\",\"incomplete\":true}]}",
        "reply {\"stop\":\"length\",\"content\":[{\"type\":\"tool\",\"id\":\"d2\",\"name\":\"draft\",\"incomplete\":true}]}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"d1\",\"name\":\"draft\",\"input\":{\"topic\":\"회의\"}}]}",
        "reply {\"stop\":\"length\",\"content\":[{\"type\":\"text\",\"text\":\"초안을 다듬으면\"},{\"type\":\"tool\",\"id\":\"d3\",\"name\":\"draft\",\"incomplete\":true}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"초안 1을 썼다.\"}]}",
        "ask {\"text\":\"회의 초안을 써 줘\"}",
        "ask {\"text\":\"결과만 알려 줘\"}",
        "config {\"max_turns\":2}",
        "reply {\"stop\":\"length\",\"content\":[{\"type\":\"tool\",\"id\":\"e1\",\"name\":\"draft\",\"incomplete\":true}]}",
        "reply {\"stop\":\"length\",\"content\":[{\"type\":\"text\",\"text\":\"다시 줄이면\"},{\"type\":\"tool\",\"id\":\"e2\",\"name\":\"draft\",\"incomplete\":true}]}",
        "ask {\"text\":\"짧은 초안\"}",
        "config {\"reply_limit\":1000,\"max_turns\":1}",
        "reply {\"stop\":\"length\",\"content\":[{\"type\":\"text\",\"text\":\"한도에 닿았다\"},{\"type\":\"tool\",\"id\":\"e3\",\"name\":\"draft\",\"incomplete\":true}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"끝.\"}]}",
        "ask {\"text\":\"한 번 더\"}",
        "ask {\"text\":\"요약\"}"
      ],
      "expected": [
        "user text \"회의 초안을 써 줘\"",
        "turn 1 messages=1 limit=300",
        "model text \"초안을 쓰겠다.\"",
        "model tool d1 draft {\"topic\":\"회의\"}",
        "model tool d2 draft incomplete",
        "stop length",
        "discard",
        "turn 2 messages=1 limit=600",
        "model tool d2 draft incomplete",
        "stop length",
        "discard",
        "turn 3 messages=1 limit=1000",
        "model tool d1 draft {\"topic\":\"회의\"}",
        "stop tool",
        "user result d1 ok \"초안 1\"",
        "turn 4 messages=3 limit=1000",
        "model text \"초안을 다듬으면\"",
        "model tool d3 draft incomplete",
        "stop length",
        "discard",
        "done length \"초안을 다듬으면\"",
        "user text \"결과만 알려 줘\"",
        "turn 1 messages=3 limit=300",
        "model text \"초안 1을 썼다.\"",
        "stop end",
        "done end \"초안 1을 썼다.\"",
        "user text \"짧은 초안\"",
        "turn 1 messages=5 limit=300",
        "model tool e1 draft incomplete",
        "stop length",
        "discard",
        "turn 2 messages=5 limit=600",
        "model text \"다시 줄이면\"",
        "model tool e2 draft incomplete",
        "stop length",
        "discard",
        "done max_turns \"다시 줄이면\"",
        "user text \"한 번 더\"",
        "turn 1 messages=5 limit=1000",
        "model text \"한도에 닿았다\"",
        "model tool e3 draft incomplete",
        "stop length",
        "discard",
        "done length \"한도에 닿았다\"",
        "user text \"요약\"",
        "turn 1 messages=5 limit=1000",
        "model text \"끝.\"",
        "stop end",
        "done end \"끝.\""
      ]
