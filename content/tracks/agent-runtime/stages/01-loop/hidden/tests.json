      ],
      "quote": "실행기는 만든 결과 블록을 도구 사용 블록과 같은 순서로 담은 사용자 메시지 하나를 기록 끝에 더하고 결과 블록을 그 순서대로 한 줄씩 출력한다.",
      "input": [
        "fake {\"tool\":\"stock\",\"input\":{\"sku\":\"B-7\"},\"output\":\"0\"}",
        "fake {\"tool\":\"ship\",\"input\":{\"sku\":\"B-7\"},\"output\":\"내일 도착\"}",
        "tool {\"name\":\"stock\"}",
        "tool {\"name\":\"price\"}",
        "fake {\"tool\":\"price\",\"input\":{\"sku\":\"B-7\"},\"output\":\"\"}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"tool\",\"id\":\"u1\",\"name\":\"ship\",\"input\":{\"sku\":\"B-7\"}},{\"type\":\"tool\",\"id\":\"u2\",\"name\":\"stock\",\"input\":{\"sku\":\"B-7\"}},{\"type\":\"tool\",\"id\":\"u3\",\"name\":\"price\",\"input\":{\"sku\":\"B-8\"}},{\"type\":\"tool\",\"id\":\"u4\",\"name\":\"price\",\"input\":{\"sku\":\"B-7\"}}]}",
        "reply {\"stop\":\"tool\",\"content\":[{\"type\":\"text\",\"text\":\"배송 도구가 없다. \"},{\"type\":\"text\",\"text\":\"재고를 다시 본다.\"},{\"type\":\"tool\",\"id\":\"u5\",\"name\":\"stock\",\"input\":{\"sku\":\"B-7\"}}]}",
        "reply {\"stop\":\"end\",\"content\":[{\"type\":\"text\",\"text\":\"B-7 은 \"},{\"type\":\"text\",\"text\":\"품절이다.\"}]}",
        "ask {\"text\":\"B-7 을 주문할 수 있어?\"}"
      ],
      "expected": [
        "user text \"B-7 을 주문할 수 있어?\"",
        "turn 1 messages=1 limit=1000",
        "model tool u1 ship {\"sku\":\"B-7\"}",
        "model tool u2 stock {\"sku\":\"B-7\"}",
        "model tool u3 price {\"sku\":\"B-8\"}",
        "model tool u4 price {\"sku\":\"B-7\"}",
        "stop tool",
        "user result u1 error \"unknown tool: ship\"",
        "user result u2 ok \"0\"",
        "user result u3 error \"no result for this input\"",
        "user result u4 ok \"\"",
        "turn 2 messages=3 limit=1000",
        "model text \"배송 도구가 없다. \"",
        "model text \"재고를 다시 본다.\"",
        "model tool u5 stock {\"sku\":\"B-7\"}",
        "stop tool",
        "user result u5 ok \"0\"",
        "turn 3 messages=5 limit=1000",
        "model text \"B-7 은 \"",
        "model text \"품절이다.\"",
        "stop end",
        "done end \"B-7 은 품절이다.\""
      ]
    },
