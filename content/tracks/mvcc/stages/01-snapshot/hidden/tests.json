        "me OK",
        "me OK",
        "me b1=old b3=new b5=mine",
        "other b1=old b2=x b3=old b4=x",
        "other COMMIT",
        "me b1=old b3=new b5=mine",
        "me b3=new",
        "late BEGIN",
        "late b1=old b2=x b3=old b4=x",
        "me COMMIT",
        "late b1=old b2=x b3=new b4=x b5=mine"
      ]
