{
  "timeout_sec": 10,
  "tests": [
    {
      "name": "begin-write-read-commit",
      "refs": [
        "4.9",
        "4.10",
        "4.11",
        "4.16"
      ],
      "quote": "`READ <트랜잭션> <키>` 는 그 트랜잭션에 보이는 키의 값을 읽어 `<트랜잭션> <키>=<값>` 을 출력한다.",
      "input": [
        "BEGIN t1",
        "WRITE t1 apple 3",
        "READ t1 apple",
        "READ t1 pear",
        "COMMIT t1",
        "BEGIN t2",
        "READ t2 apple",
        "COMMIT t2"
      ],
      "expected": [
        "t1 BEGIN",
        "t1 OK",
        "t1 apple=3",
        "t1 pear=(none)",
        "t1 COMMIT",
        "t2 BEGIN",
        "t2 apple=3",
        "t2 COMMIT"
      ]
    },
    {
      "name": "uncommitted-writes-hidden",
      "refs": [
        "4.8",
        "4.11",
        "4.12",
        "3.2",
        "4.4"
      ],
      "quote": "다른 트랜잭션이 쓰고 아직 커밋하지 않은 값은 보이지 않는다.",
      "input": [
        "BEGIN w",
        "BEGIN r",
        "WRITE w color red",
        "WRITE w color blue",
        "READ w color",
        "READ r color",
        "SCAN r a z",
        "COMMIT w",
        "READ r color",
        "BEGIN v REPEATABLE READ",
        "READ v color"
      ],
      "expected": [
        "w BEGIN",
        "r BEGIN",
        "w OK",
        "w OK",
        "w color=blue",
        "r color=(none)",
        "r (none)",
        "w COMMIT",
        "r color=blue",
        "v BEGIN",
        "v color=blue"
      ]
    },
    {
      "name": "read-committed-statement-snapshot",
      "refs": [
        "4.7",
        "4.4",
