      ],
      "quote": "READ COMMITTED 트랜잭션은 READ 와 SCAN 을 실행할 때마다 그 순간의 스냅숏을 새로 만들어 쓴다.",
      "input": [
        "BEGIN init",
        "WRITE init acct1 100",
        "WRITE init acct3 300",
        "COMMIT init",
        "BEGIN rc READ COMMITTED",
        "READ rc acct1",
        "SCAN rc acct acct9",
        "BEGIN up",
        "WRITE up acct1 150",
        "WRITE up acct2 200",
        "READ rc acct1",
        "COMMIT up",
        "READ rc acct1",
        "SCAN rc acct acct9",
        "WRITE rc acct3 50",
        "SCAN rc acct acct9",
        "COMMIT rc"
      ],
      "expected": [
        "init BEGIN",
        "init OK",
        "init OK",
        "init COMMIT",
        "rc BEGIN",
        "rc acct1=100",
        "rc acct1=100 acct3=300",
        "up BEGIN",
        "up OK",
        "up OK",
        "rc acct1=100",
        "up COMMIT",
        "rc acct1=150",
        "rc acct1=150 acct2=200 acct3=300",
        "rc OK",
        "rc acct1=150 acct2=200 acct3=50",
        "rc COMMIT"
      ]
    },
