{
  "timeout_sec": 10,
  "tests": [
    {
      "name": "write-waits-for-lock",
      "refs": [
        "4.7",
        "4.9",
        "4.10",
        "4.11",
        "4.4"
      ],
      "quote": "기다리는 트랜잭션의 이름을 쓴 문법에 맞는 줄은 BEGIN 이 아니면 실행하지 않고 그 트랜잭션의 대기열 끝에 넣는다.",
      "input": [
        "BEGIN init",
        "WRITE init seat free",
        "COMMIT init",
        "BEGIN a",
        "BEGIN b",
        "WRITE a seat alice",
        "WRITE b seat bob",
        "READ b seat",
        "COMMIT b",
        "BEGIN c",
        "READ c seat",
        "SCAN c a z",
        "COMMIT a",
        "READ c seat"
      ],
      "expected": [
        "init BEGIN",
        "init OK",
        "init COMMIT",
        "a BEGIN",
        "b BEGIN",
        "a OK",
        "b WAIT a",
        "c BEGIN",
        "c seat=free",
        "c seat=free",
        "a COMMIT",
        "b OK",
        "b seat=bob",
        "b COMMIT",
        "c seat=bob"
      ]
    },
    {
      "name": "shared-exclusive-compatibility",
      "refs": [
        "4.2",
        "4.5",
        "4.6",
        "4.9"
      ],
      "quote": "서로 다른 트랜잭션이 건 두 잠금은 두 대상에 함께 든 키가 하나라도 있고 두 모드 가운데 하나라도 X 이면 충돌한다.",
      "input": [
        "BEGIN init",
        "WRITE init k 1",
        "COMMIT init",
        "BEGIN p",
        "BEGIN q",
        "BEGIN r",
        "READ p k FOR SHARE",
        "READ q k FOR SHARE",
        "READ r k FOR UPDATE",
        "READ p k FOR UPDATE",
        "ROLLBACK q",
        "WRITE p k 2",
        "READ p k FOR SHARE",
        "COMMIT p",
        "COMMIT r"
      ],
      "expected": [
        "init BEGIN",
        "init OK",
        "init COMMIT",
        "p BEGIN",
        "q BEGIN",
        "r BEGIN",
        "p k=1",
        "q k=1",
        "r WAIT p q",
        "p WAIT q",
        "q ROLLBACK",
        "p k=1",
        "p OK",
        "p k=2",
        "p COMMIT",
        "r k=2",
        "r COMMIT"
      ]
    },
