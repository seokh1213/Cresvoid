{
  "timeout_sec": 10,
  "tests": [
    {
      "name": "serializable-snapshot-and-conflict",
      "refs": [
        "4.1",
        "4.2"
      ],
      "quote": "BEGIN 을 실행한 순간의 스냅숏 하나로 읽고 COMMIT 에서 쓰기 충돌을 판정한다.",
      "input": [
        "BEGIN init",
        "WRITE init item 1",
        "COMMIT init",
        "BEGIN s SERIALIZABLE",
        "BEGIN w",
        "WRITE w item 2",
        "COMMIT w",
        "READ s item",
        "WRITE s other 5",
        "READ s other",
        "COMMIT s",
        "BEGIN s2 SERIALIZABLE",
        "BEGIN w2",
        "WRITE w2 item 3",
        "COMMIT w2",
        "WRITE s2 item 4",
        "COMMIT s2",
        "BEGIN chk",
        "READ chk item",
        "READ chk other"
      ],
      "expected": [
        "init BEGIN",
        "init OK",
        "init COMMIT",
        "s BEGIN",
        "w BEGIN",
        "w OK",
        "w COMMIT",
        "s item=1",
        "s OK",
        "s other=5",
        "s COMMIT",
        "s2 BEGIN",
        "w2 BEGIN",
        "w2 OK",
        "w2 COMMIT",
        "s2 OK",
        "s2 ABORT WRITE_CONFLICT item",
        "chk BEGIN",
        "chk item=3",
        "chk other=5"
      ]
    },
    {
      "name": "joint-account-withdrawals",
      "refs": [
        "4.11",
        "4.8",
        "4.9",
        "4.12"
      ],
      "quote": "그 가운데 T 가 아닌 트랜잭션 하나라도 이미 커밋한 구조가 있으면 T 는 커밋에 실패한다.",
      "input": [
        "BEGIN init",
        "WRITE init x 50",
        "WRITE init y 50",
        "COMMIT init",
        "BEGIN t1 SERIALIZABLE",
        "BEGIN t2 SERIALIZABLE",
        "READ t1 x",
        "READ t1 y",
        "READ t2 x",
        "READ t2 y",
        "WRITE t1 x 0",
        "WRITE t2 y 0",
        "COMMIT t2",
        "COMMIT t1",
        "BEGIN t3 SERIALIZABLE",
        "READ t3 x",
        "READ t3 y",
        "COMMIT t3"
      ],
      "expected": [
        "init BEGIN",
        "init OK",
        "init OK",
        "init COMMIT",
        "t1 BEGIN",
        "t2 BEGIN",
        "t1 x=50",
        "t1 y=50",
        "t2 x=50",
        "t2 y=50",
        "t1 OK",
        "t2 OK",
        "t2 COMMIT",
        "t1 ABORT SERIALIZATION",
        "t3 BEGIN",
        "t3 x=50",
        "t3 y=0",
        "t3 COMMIT"
      ]
    },
    {
      "name": "range-read-dependencies",
