      ],
      "quote": "SCAN 을 실행할 때 값이 없던 키도 범위에 들면 읽은 키다.",
      "input": [
        "BEGIN s1 SERIALIZABLE",
        "BEGIN s2 SERIALIZABLE",
        "BEGIN s3 SERIALIZABLE",
        "SCAN s1 slot10 slot11",
        "SCAN s2 slot10 slot11",
        "SCAN s3 slot10 slot11",
        "WRITE s1 slot10a x",
        "WRITE s2 slot10b y",
        "WRITE s3 slot11 z",
        "COMMIT s3",
        "COMMIT s1",
        "COMMIT s2"
      ],
      "expected": [
        "s1 BEGIN",
        "s2 BEGIN",
        "s3 BEGIN",
        "s1 (none)",
        "s2 (none)",
        "s3 (none)",
        "s1 OK",
        "s2 OK",
        "s3 OK",
        "s3 COMMIT",
        "s1 ABORT SERIALIZATION",
        "s2 COMMIT"
      ]
    },
